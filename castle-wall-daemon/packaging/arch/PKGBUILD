# Maintainer: Erik Newton <eriknewton@gmail.com>

pkgname=sanctuary-castle-wall
pkgver=0.1.0
pkgrel=1
pkgdesc='Castle Wall cold-install package'
arch=('x86_64')
url='https://github.com/eriknewton/sanctuary-framework'
license=('LicenseRef-Sanctuary')
# There is deliberately no install= scriptlet: libalpm scriptlets cannot refuse
# transactions, and this first slice keeps installation inert.
_glibc_floor="$(getconf GNU_LIBC_VERSION | awk '{print $2}')"
depends=("glibc>=${_glibc_floor}" 'systemd' 'nftables' 'python' 'libnetfilter_queue' 'iproute2' 'util-linux' 'shadow')
makedepends=('rustup')
# docs and emptydirs must stay enabled; deleting them after package() would remove the bound identity and make every guarded removal refuse.
options=('!strip' '!debug' 'docs' 'emptydirs')
backup=()
source=()
sha256sums=()

_target='x86_64-unknown-linux-gnu'
_toolchain='1.95.0'

_crate_root() {
  cd "${startdir}/../.." && pwd -P
}

_scrub_rust_env() {
  local name
  while IFS='=' read -r name _; do
    case "$name" in
      CARGO_*|RUSTFLAGS|RUSTC|RUSTDOC|RUSTUP_TOOLCHAIN)
        unset "$name"
        ;;
    esac
  done < <(env)
  export CARGO_TERM_COLOR=never
}

build() {
  local crate
  crate="$(_crate_root)"
  cd "$crate"
  rustc --version | grep -F "rustc ${_toolchain} " >/dev/null
  _scrub_rust_env
  cargo build --locked --release --target "${_target}" \
    --target-dir "$srcdir/cargo-target" \
    --message-format=json \
    --bin castle-wall-daemon \
    --bin protected-agent-v1 \
    --bin network-agent-standin \
    --bin sanctuary-linux >"$srcdir/cargo.jsonl"
}

package() {
  local crate source_commit rustc_version
  crate="$(_crate_root)"
  source_commit="$(git -C "${crate}/.." rev-parse HEAD)"
  rustc_version="$(rustc --version)"
  python3 "${startdir}/build-arch-package.py" \
    --crate "$crate" \
    --dest "$pkgdir" \
    --pkgver "$pkgver" \
    --pkgrel "$pkgrel" \
    --source-commit "$source_commit" \
    --rustc-version "$rustc_version" \
    --glibc-floor "$_glibc_floor" \
    --target-dir "$srcdir/cargo-target" \
    --cargo-json "$srcdir/cargo.jsonl"
}
