[MODEL: dataset="sanctuary_audit_raw"]
ALTER
  _time = _time,
  xdm.event.type = "application",
  xdm.event.description = xdm.event.description,
  xdm.event.operation = xdm.event.operation,
  xdm.event.operation_sub_type = xdm.event.operation_sub_type,
  xdm.event.outcome = if(
    xdm.event.outcome = "success", XDM_CONST.OUTCOME_SUCCESS,
    xdm.event.outcome = "failure", XDM_CONST.OUTCOME_FAILED,
    xdm.event.outcome
  ),
  xdm.event.is_completed = xdm.event.is_completed,
  xdm.observer.product = xdm.observer.product,
  xdm.observer.vendor = xdm.observer.vendor,
  xdm.source.identity.username = xdm.source.identity.username
