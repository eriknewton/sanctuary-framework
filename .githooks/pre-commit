#!/usr/bin/env bash
#
# Sanctuary pre-commit hook — test baseline guard
# Copyright 2026 Erik Newton
# SPDX-License-Identifier: Apache-2.0
#
# Defends against the specific failure class documented in
# docs/audit/commit-4ac95830-postmortem.md: a parse / transform
# error at vitest collection time silently dropping test files
# from the suite, causing the passing count to look lower without
# vitest reporting a hard failure.
#
# Two gates, both must pass. The commit is blocked if either fails.
#
#   Gate 1: typecheck
#     Runs `npm run typecheck` in server/. Zero TypeScript errors
#     required. This is the cheap gate and runs first so the
#     expensive gate 2 never runs on a broken typecheck.
#
#   Gate 2: transform-error detection + test baseline check
#     Runs `npm test` in server/ and parses vitest's output for
#     three kinds of drift:
#
#       a. Transform / collection error substrings.
#          Any occurrence of "transform error", "failed to parse",
#          "failed to collect", "failed to load source", or
#          "cannot find module" in the vitest output aborts the
#          commit — these are the exact signatures of the
#          commit 4ac95830 failure class.
#
#       b. Silent test file drop.
#          Count .test.ts files under server/test/ and compare to
#          vitest's reported "Test Files N passed (TOTAL)" count.
#          If files on disk > files vitest attempted, some file
#          failed to load before vitest registered it — the same
#          failure shape as 4ac95830, hiding 98 tests for 26 hours.
#
#       c. Test baseline regression (BELOW the floor only).
#          If vitest's passing-test count falls below the integer
#          in .test-baseline at repo root, the commit is blocked.
#          A count ABOVE the floor is the normal resting state and
#          passes: CI publishes the observed count from the default
#          branch after each push, and a pull request is held to that
#          published number, so a commit that adds tests owes nobody an
#          integer. `.test-baseline` is the FALLBACK floor, used when no
#          published count is available.
#
#          WHY THE FAIL-ABOVE DEMAND IS GONE: the floor is the passing
#          count on Linux CI, which an author on macOS cannot compute.
#          Demanding it in the commit made the number a guess, and the
#          routine way through a wrong guess was SKIP_TEST_BASELINE=1,
#          which is how a gate stops being a gate. The staleness that
#          demand existed to prevent is now answered structurally: the
#          floor is rewritten after every merge, so it is at most one
#          merge behind reality.
#
#          The one remaining reason to edit .test-baseline by hand is
#          the deliberate-lowering path: tests removed on purpose,
#          with a written justification in the commit and the pull
#          request. This hook warns on that edit rather than blocking
#          it, because it cannot read a justification; the reviewer is
#          the gate there.
#
# Runtime budget: < 60 seconds on a modern Mac. Typecheck is ~3s,
# the test suite is ~20s, total well under the budget.
#
# Emergency override: set SKIP_TEST_BASELINE=1 to bypass the hook.
# Use only for emergency commits. The override is REFUSED unless a
# human-readable justification is also supplied in SKIP_REASON, e.g.:
#   SKIP_TEST_BASELINE=1 SKIP_REASON="hotfix: CI runner outage, see #NNN" git commit ...
# The override is logged to .test-baseline-overrides.log with timestamp,
# HEAD SHA, branch, author (whoami), and the reason for audit.
#
# Enforcement status (be precise — do NOT call this hook "not
# bypassable"): this LOCAL hook is the fast first line, but it is
# CI-enforced with an audited emergency override — it can be skipped
# with `SKIP_TEST_BASELINE=1` (documented + logged above) or with
# `git commit --no-verify`, and it is absent in environments where the
# hook was never installed. The HARD merge gate is the CI mirror at
# .github/workflows/test-baseline-guard.yml (made a required status
# check via the branch-protection runbook in
# docs/audit/branch-protection-setup.md). Treat this hook as the local
# convenience copy of that authority, not a guarantee on its own.
#
# Installation:
#   cd server && npm run install-hooks
#
# This hook is a shared script at .githooks/pre-commit; the install
# script copies it to .git/hooks/pre-commit and chmods it executable.

set -euo pipefail

# ── Colour helpers (graceful fallback if TTY is not colour) ─────────
if [[ -t 2 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  BLUE=$'\033[0;34m'
  NC=$'\033[0m'
else
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  NC=""
fi

log()  { printf '%s[baseline-guard]%s %s\n' "$BLUE" "$NC" "$1" >&2; }
warn() { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$YELLOW" "$1" "$NC" >&2; }
fail() { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$RED" "$1" "$NC" >&2; }
ok()   { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$GREEN" "$1" "$NC" >&2; }

# ── Counter validation (fail CLOSED) ────────────────────────────────
# The vitest-derived counters (`actual_total`, `passing`) are extracted from
# vitest's text output with `grep -oE "[0-9]+"`. The capture is *shaped* like a
# non-negative integer, but two pathological inputs are still possible and both
# would corrupt the arithmetic guards downstream:
#
#   - a leading-zero string (e.g. "007") — historically a source of octal-parse
#     surprises in `(( ... ))`; we reject it for the same reason we reject a
#     leading-zero .test-baseline above; and
#   - an absurdly large value (e.g. a 19-digit string) that overflows bash's
#     signed-64-bit `(( ... ))` arithmetic and silently wraps (the macOS system
#     bash is 3.2), so a numeric `(( _val > MAX ))` guard CANNOT catch it — the
#     comparison itself overflows. Left unchecked, a wrapped-negative count would
#     turn a "passing < baseline" regression check into a false PASS.
#
# So before ANY arithmetic touches a counter, validate it here and fail CLOSED.
# The upper bound is enforced by DIGIT COUNT first (a value with more digits than
# COUNTER_MAX is unambiguously larger and must never reach (( ))); only a value
# already known to fit is compared numerically. A real suite never approaches
# 100,000,000 tests/files, so a legitimate run never trips this; only a
# parse-corrupted or adversarial value does. Args: <human-name> <value>.
#
# This MUST be invoked as a plain statement (`validate_counter NAME "$v"`), NOT
# inside a command substitution: bash 3.2 does not propagate an `exit` out of a
# `$(...)` subshell to abort the parent under `set -e`, which would fail OPEN.
COUNTER_MAX=100000000   # 9 digits; see digit-count guard below.
validate_counter() {
  local _name="$1" _val="$2"
  if ! [[ "$_val" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "$_name from vitest output is not a canonical integer, got: '$_val' — commit blocked"
    exit 1
  fi
  # Reject by digit count first (overflow-safe), then numerically for same-length
  # values. A value with MORE digits than COUNTER_MAX is definitely larger; a
  # value with the SAME digit count is compared with (( )), which is safe because
  # it is known to fit in 64-bit.
  if (( ${#_val} > ${#COUNTER_MAX} )) \
     || { (( ${#_val} == ${#COUNTER_MAX} )) && (( _val > COUNTER_MAX )); }; then
    fail "$_name from vitest output ($_val) exceeds the sane upper bound ($COUNTER_MAX) — commit blocked"
    printf '[baseline-guard]   This is almost certainly a parse-corrupted or adversarial value; refusing\n' >&2
    printf '[baseline-guard]   to run arithmetic on it (overflow could mask a regression).\n' >&2
    exit 1
  fi
  return 0
}

# ── Emergency override ───────────────────────────────────────────────
if [[ "${SKIP_TEST_BASELINE:-}" == "1" ]]; then
  # An accountable override REQUIRES a reason. Refuse a bare bypass: an
  # unexplained skip is exactly the unaudited shortcut this audit log exists to
  # prevent. `SKIP_REASON` must be a non-empty, non-whitespace string.
  skip_reason="${SKIP_REASON:-}"
  if [[ -z "${skip_reason//[[:space:]]/}" ]]; then
    fail "SKIP_TEST_BASELINE=1 was set WITHOUT a justification — override refused."
    printf '[baseline-guard]   An emergency override must be accountable. Re-run with a reason:\n' >&2
    printf '[baseline-guard]     SKIP_TEST_BASELINE=1 SKIP_REASON="why you are bypassing" git commit ...\n' >&2
    exit 1
  fi
  # Collapse newlines/tabs so a multi-line reason cannot corrupt the single-line
  # log record (each override is exactly one tab-delimited line).
  skip_reason=$(printf '%s' "$skip_reason" | tr '\n\t' '  ')
  warn "SKIP_TEST_BASELINE=1 — emergency override active"
  warn "This commit is being made without running the baseline guard."
  warn "Override is logged to .test-baseline-overrides.log for audit."
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  head_sha=$(git rev-parse HEAD 2>/dev/null || echo "pre-commit")
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown-branch")
  author=$(whoami 2>/dev/null || echo "unknown-user")
  repo_root_for_log=$(git rev-parse --show-toplevel)
  # Tab-delimited: timestamp <tab> sha <tab> branch <tab> author <tab> reason.
  # Append-only; union-merged on rebase via .gitattributes (DoE 3a/N-3).
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$timestamp" "$head_sha" "$branch" "$author" "$skip_reason" \
    >> "$repo_root_for_log/.test-baseline-overrides.log"
  exit 0
fi

# Resolve repo root (allows hook to run from any subdirectory).
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Gate 1: typecheck ────────────────────────────────────────────────
log "Gate 1/2: npm run typecheck"
if ! (cd server && npm run typecheck --silent > /tmp/sanctuary-precommit-tsc.log 2>&1); then
  fail "TYPECHECK FAILED — commit blocked"
  tail -40 /tmp/sanctuary-precommit-tsc.log >&2
  printf '\n' >&2
  fail "Fix all TypeScript errors before committing."
  printf '[baseline-guard] To override in an emergency: SKIP_TEST_BASELINE=1 git commit ...\n' >&2
  exit 1
fi
ok "Gate 1/2: typecheck clean."

# ── Gate 2: transform-error detection + test baseline ───────────────
log "Gate 2/2: npm test + transform-error detection + baseline check"

# Resolve the enforcement floor from the SOURCE THAT WILL BE COMMITTED — never the
# unstaged working tree (the bypass this guard closes).
#
# Why not the working tree: if we read .test-baseline off disk here, an author
# could raise it on disk (so passing == the on-disk number) WITHOUT staging it.
# Then the fail-above ratchet check below (passing > baseline) sees passing ==
# baseline and skips entirely, so the actually-committed floor stays stale and a
# later regression can hide under it. The on-disk edit isn't even part of the
# commit. So the floor must come from git's object store, not the working tree.
#
# The floor IN EFFECT for this commit is HEAD's committed blob
# (`HEAD:.test-baseline`). A staged edit to the file is the deliberate-lowering
# path and is annunciated separately below; keeping the regression floor at HEAD
# means a staged lowering does not retroactively excuse a regression in the same
# commit.
baseline_is_staged=""
if git diff --cached --name-only 2>/dev/null | grep -qx ".test-baseline"; then
  baseline_is_staged="yes"
fi

# HISTORY, kept because the reasoning still binds: the hook used to demand that
# a passing count above the floor be "accounted for" by staging a raised
# .test-baseline. On a macOS dev box the local count ALWAYS exceeds the Linux
# floor by the platform delta (macOS-gated suites that skip on Linux), so
# `passing > baseline` is the normal resting state locally and the demand asked
# for an accounting that did not exist. The routine way through was
# SKIP_TEST_BASELINE=1 (observed 2026-07-18, PR #965), and a gate that must be
# bypassed to do ordinary work stops being a gate. A carve-out for commits
# staging nothing under server/ narrowed that, and the redesign below removes
# the demand entirely: CI publishes the count from the default branch after every
# push, so nothing local ever needs to state it.
#
# The fail-BELOW regression check still blocks unconditionally, on every commit,
# regardless of what is staged, and the CI guard
# (.github/workflows/test-baseline-guard.yml) remains the authority this local
# hook is the fast convenience copy of.

# `|| true`: under `set -o pipefail` a failing `git show` (e.g. no HEAD on the
# first-ever commit) would otherwise propagate non-zero through the command
# substitution and abort the hook under `set -e`. We want the empty-value handling
# below to run instead.
baseline=$(git show HEAD:.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
# First-ever commit of the file (no HEAD blob): treat the floor as 0 so the
# fail-above block requires the introducing value to be staged and validated.
if [[ -z "$baseline" ]]; then
  baseline=0
fi
if ! [[ "$baseline" =~ ^(0|[1-9][0-9]*)$ ]]; then
  fail "committed .test-baseline (HEAD:.test-baseline) is not a single integer, got: '$baseline'"
  exit 1
fi

# A .test-baseline must exist on disk for the repo to be in a sane state, but its
# CONTENT is intentionally NOT used for enforcement (see above). Missing-file is
# still worth flagging unless it is being introduced (staged) in this commit.
if [[ ! -f .test-baseline && -z "$baseline_is_staged" ]]; then
  fail ".test-baseline file missing at repo root"
  printf '[baseline-guard]   Create it with a single integer (the current passing count) and stage it.\n' >&2
  exit 1
fi

# Defense-in-depth diagnostic: if the working-tree file disagrees with the
# enforced (committed) floor, surface it. An UNSTAGED raise is exactly the bypass
# shape, so make it loud — it is being IGNORED for enforcement, by design.
if [[ -f .test-baseline ]]; then
  worktree_baseline=$(tr -d '[:space:]' < .test-baseline)
  if [[ "$worktree_baseline" =~ ^(0|[1-9][0-9]*)$ && "$worktree_baseline" != "$baseline" && -z "$baseline_is_staged" ]]; then
    warn "working-tree .test-baseline ($worktree_baseline) differs from the committed floor ($baseline) and is UNSTAGED."
    warn "The unstaged edit will NOT be committed and is IGNORED for enforcement. Stage it (git add .test-baseline) to make it count."
  fi
fi

# Count test files on disk (expected).
expected_files=$(find server/test -name "*.test.ts" -not -path "*/node_modules/*" 2>/dev/null | wc -l | tr -d '[:space:]')
if [[ -z "$expected_files" || "$expected_files" == "0" ]]; then
  fail "No test files found under server/test/ — something is wrong"
  exit 1
fi

# Run the test suite and capture BOTH output and exit code. Using
# `set +e` around the assignment means the subshell's non-zero exit
# does not abort this hook under `set -e` — we want to inspect the
# captured output to classify the failure before deciding how to
# report it.
set +e
test_output=$(cd server && npm test 2>&1)
test_exit=$?
set -e

# ── Check 2a: transform / collection failure classification ────────
#
# The 2026-04-10 incident (commit 4ac95830) was a parse error at
# vitest's transform step that caused test files to drop silently.
# The PRIMARY signal is vitest's exit code — if `npm test` returns
# non-zero, the commit MUST be blocked regardless of any substring
# parsing. The substring match then runs as a classifier to decide
# whether to name the error as the specific 4ac95830 failure class
# or as a generic test failure.
#
# Patterns covered (case-insensitive):
#
#   "transform failed"           — vite:esbuild plugin message
#                                  (e.g. "Transform failed with 1 error")
#   "transform error"            — alternate vitest transform message
#   "failed to parse"            — esbuild / swc parse error
#   "failed to collect"          — vitest collection failure
#   "failed to load source"      — vitest source-loading failure
#   "cannot find module"         — missing import or dependency
#   "Failed Suites"              — vitest summary header for
#                                  suite-level failures (shown when
#                                  a test file fails to register)
#
# Any match in combination with non-zero exit classifies the failure
# as a transform/collection error and points the reader at the
# 4ac95830 postmortem. A non-zero exit WITHOUT a matching substring
# is a generic test failure and is blocked with a simpler message.
TRANSFORM_ERROR_PATTERNS='(transform failed|transform error|failed to parse|failed to collect|failed to load source|cannot find module|failed suites)'

if (( test_exit != 0 )); then
  if echo "$test_output" | grep -Eqi "$TRANSFORM_ERROR_PATTERNS"; then
    fail "TRANSFORM/COLLECTION ERROR DETECTED — commit blocked"
    printf '\n' >&2
    echo "$test_output" | grep -Ei "$TRANSFORM_ERROR_PATTERNS" | head -20 >&2
    printf '\n' >&2
    fail "This is the specific failure class from commit 4ac95830:"
    printf '[baseline-guard]   a parse/transform error causing test files to fail at\n' >&2
    printf '[baseline-guard]   vitest collection time. See\n' >&2
    printf '[baseline-guard]   docs/audit/commit-4ac95830-postmortem.md\n' >&2
    exit 1
  fi
  fail "TEST SUITE FAILED (exit code $test_exit) — commit blocked"
  printf '\n' >&2
  echo "$test_output" | tail -40 >&2
  exit 1
fi

# Exit code was zero, but ALSO scan for transform-error substrings
# as defense-in-depth. In theory a vitest version could report the
# error without failing the run (unlikely but worth the extra line).
if echo "$test_output" | grep -Eqi "$TRANSFORM_ERROR_PATTERNS"; then
  fail "TRANSFORM/COLLECTION ERROR DETECTED (despite zero exit) — commit blocked"
  printf '\n' >&2
  echo "$test_output" | grep -Ei "$TRANSFORM_ERROR_PATTERNS" | head -20 >&2
  printf '\n' >&2
  fail "This is the specific failure class from commit 4ac95830."
  printf '[baseline-guard]   See docs/audit/commit-4ac95830-postmortem.md\n' >&2
  exit 1
fi

# ── Check 2b: silent test file drop ─────────────────────────────────
#
# Parse vitest's "Test Files  N passed (TOTAL)" summary line. The
# number inside parentheses is vitest's attempted-file count. If
# files on disk exceed that count, some file(s) dropped silently
# during collection — the exact failure class from 4ac95830.
actual_total=$(echo "$test_output" | grep -oE "Test Files[[:space:]]+.*\([0-9]+\)" | grep -oE "\([0-9]+\)" | tr -d '()' | tail -1)
if [[ -z "$actual_total" ]]; then
  # Fallback for older vitest output shape.
  actual_total=$(echo "$test_output" | grep -oE "Test Files[[:space:]]+[0-9]+ passed" | grep -oE "[0-9]+" | head -1)
fi
if [[ -z "$actual_total" ]]; then
  fail "Could not parse 'Test Files' count from vitest output"
  echo "$test_output" | tail -30 >&2
  exit 1
fi
# Validate before any arithmetic (fail CLOSED on non-canonical / overflow).
validate_counter "Test Files count" "$actual_total"

if (( actual_total < expected_files )); then
  fail "SILENT TEST FILE DROP DETECTED — commit blocked"
  printf '[baseline-guard]   Files on disk under server/test/: %s\n' "$expected_files" >&2
  printf '[baseline-guard]   Files vitest reported:            %s\n' "$actual_total" >&2
  printf '[baseline-guard]   Missing: %s test file(s).\n' "$((expected_files - actual_total))" >&2
  printf '\n' >&2
  fail "This is the specific failure class from commit 4ac95830."
  printf '[baseline-guard]   See docs/audit/commit-4ac95830-postmortem.md\n' >&2
  exit 1
fi

# ── Check 2c: passing count >= baseline ─────────────────────────────
#
# Parse "Tests  N passed" (the "| M skipped" suffix is ignored).
passing=$(echo "$test_output" | grep -oE "Tests[[:space:]]+[0-9]+ passed" | grep -oE "[0-9]+" | head -1)
if [[ -z "$passing" ]]; then
  fail "Could not parse passing-test count from vitest output"
  echo "$test_output" | tail -30 >&2
  exit 1
fi
# Validate before any arithmetic (fail CLOSED on non-canonical / overflow).
validate_counter "passing-test count" "$passing"

if (( passing < baseline )); then
  fail "TEST BASELINE REGRESSION — commit blocked"
  printf '[baseline-guard]   Committed floor (HEAD:.test-baseline): %s\n' "$baseline" >&2
  printf '[baseline-guard]   Current passing count:                 %s\n' "$passing" >&2
  printf '[baseline-guard]   Regression: %s tests\n' "$((baseline - passing))" >&2
  printf '\n' >&2
  fail "Fix the regression, or update .test-baseline in a separate"
  fail "explicitly-scoped commit explaining the bump."
  exit 1
fi

# A staged edit to .test-baseline. Under this design nothing routine touches
# the file: it is the FALLBACK floor, used only when no published count is
# available, and humans update it rarely. So an edit here is one of two things,
# and both want to be seen rather than blocked.
#
#   A DELIBERATE LOWERING. Tests were removed on purpose and the floor is being
#   brought down to match. That is legitimate, it needs a written justification
#   in the commit and the pull request, and this hook cannot read a
#   justification, so it warns and lets the reviewer be the gate.
#
#   A RAISE. Harmless but pointless: the recorder overwrites it with the count
#   Linux actually observes after the merge. Worse, a raise ABOVE the local
#   passing count is a floor no run can meet, and it blocks the next commit
#   with a regression that is not one. That one is still refused.
#
# Failure mode note for a reader wondering why the raise is refused only when it
# exceeds local passing: on macOS the local count legitimately EXCEEDS the Linux
# floor, so a value between the two is indistinguishable from a correct Linux
# floor and cannot be judged here. CI judges it in minutes.
if [[ -n "$baseline_is_staged" ]]; then
  staged_baseline=$(git show :.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
  if ! [[ "$staged_baseline" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "STAGED .test-baseline IS NOT A SINGLE INTEGER (or was deleted) — commit blocked"
    printf '[baseline-guard]   Staged value: %s\n' "'$staged_baseline'" >&2
    printf '[baseline-guard] Override (emergency): SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
  if (( staged_baseline > passing )); then
    fail "STAGED .test-baseline ($staged_baseline) EXCEEDS the current passing count ($passing) — commit blocked"
    printf '[baseline-guard]   A floor above what any run can reach blocks the next commit with a\n' >&2
    printf '[baseline-guard]   regression that is not one, and can mask a real regression up to the\n' >&2
    printf '[baseline-guard]   inflated number. CI records the true floor on main after the merge;\n' >&2
    printf '[baseline-guard]   you do not need to state it here at all.\n' >&2
    printf '[baseline-guard] Override (emergency): SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
  if (( staged_baseline < baseline )); then
    warn "This commit LOWERS the committed floor from $baseline to $staged_baseline."
    warn "That is the deliberate-lowering path: legitimate only when tests were removed"
    warn "on purpose, and it needs a written justification in this commit and its pull"
    warn "request. Nothing else should ever edit .test-baseline by hand."
  elif (( staged_baseline > baseline )); then
    warn "This commit raises the committed floor from $baseline to $staged_baseline."
    warn "Usually unnecessary: the floor a pull request is held to is the count CI"
    warn "published from the default branch, and this file is only the fallback."
  fi
fi

# Above the floor is the ordinary resting state, both because a change may add
# tests and because a macOS box runs more of them than Linux does. It is
# reported, never blocked, and the floor is left alone.
if (( passing > baseline )); then
  ok "Passing count ($passing) is $((passing - baseline)) above the committed floor ($baseline)."
  ok "Nothing to do: CI publishes the default branch's count after this merges."
fi

ok "Gate 2/2: $actual_total test files loaded, $passing tests passed (baseline: $baseline)."
ok "All baseline-guard checks passed. Commit allowed."
exit 0
