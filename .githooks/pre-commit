#!/usr/bin/env bash
#
# Sanctuary pre-commit hook - test baseline guard
# Copyright 2026 Erik Newton
# SPDX-License-Identifier: Apache-2.0
#
# Defends against the specific failure class documented in
# docs/audit/commit-4ac95830-postmortem.md: a parse / transform
# error at vitest collection time silently dropping test files
# from the suite, causing the passing count to look lower without
# vitest reporting a hard failure.
#
# Two gates, both must pass. The commit is blocked if either fails.
#
#   Gate 1: typecheck
#     Runs `npm run typecheck` in server/. Zero TypeScript errors
#     required. This is the cheap gate and runs first so the
#     expensive gate 2 never runs on a broken typecheck.
#
#   Gate 2: transform-error detection + test baseline check
#     Runs `npm test` in server/ and parses vitest's output for
#     three kinds of drift:
#
#       a. Transform / collection error substrings.
#          Any occurrence of "transform error", "failed to parse",
#          "failed to collect", "failed to load source", or
#          "cannot find module" in the vitest output aborts the
#          commit - these are the exact signatures of the
#          commit 4ac95830 failure class.
#
#       b. Silent test file drop.
#          Delegates to scripts/gate2b-check.sh - the same
#          implementation CI's Gate 2b calls - which compares the
#          test files VITEST ITSELF discovers (`vitest list
#          --filesOnly`, via server/scripts/count-vitest-test-files.mjs)
#          against vitest's reported "Test Files N passed (TOTAL)"
#          count from this run. If vitest ran fewer files than its own
#          discovery found, some file failed to load before vitest
#          registered it - the same failure shape as 4ac95830, hiding
#          98 tests for 26 hours.
#
#       c. Test baseline drift (BOTH directions).
#          If vitest's passing-test count falls below the integer
#          in .test-baseline at repo root, the commit is blocked.
#          If the passing count rises ABOVE the baseline without the
#          author bumping .test-baseline in the SAME commit, the
#          commit is also blocked: a silent ratchet-up lets a later
#          regression hide under the stale floor (the new passing
#          tests mask the loss). The fix is mechanical and required -
#          stage the new count in .test-baseline. Net-zero churn
#          commits (count == baseline) pass untouched.
#
#          PLATFORM-DELTA CARVE-OUT: the fail-above demand applies
#          only to commits that stage something under server/. On a
#          macOS dev box the local passing count always exceeds the
#          Linux floor by the platform delta (macOS-gated suites that
#          skip on Linux), so `passing > baseline` is the normal
#          resting state, not a signal. A commit staging nothing under
#          server/ cannot have added a test, so demanding a bump there
#          asked for an accounting that did not exist and made
#          SKIP_TEST_BASELINE=1 the routine way to commit a docs edit.
#          That is how a gate stops being a gate. Such commits now warn
#          with the observed delta and pass; the floor is untouched.
#          The fail-BELOW regression check still blocks on every commit,
#          and the CI mirror (which runs on Linux, where no delta
#          exists) still enforces the floor exactly.
#
# Runtime budget: < 60 seconds on a modern Mac. Typecheck is ~3s,
# the test suite is ~20s, total well under the budget.
#
# Emergency override: set SKIP_TEST_BASELINE=1 to bypass the hook.
# Use only for emergency commits. The override is REFUSED unless a
# human-readable justification is also supplied in SKIP_REASON, e.g.:
#   SKIP_TEST_BASELINE=1 SKIP_REASON="hotfix: CI runner outage, see #NNN" git commit ...
# The override is logged to .test-baseline-overrides.log with timestamp,
# HEAD SHA, branch, author (whoami), and the reason for audit.
#
# Enforcement status (be precise - do NOT call this hook "not
# bypassable"): this LOCAL hook is the fast first line, but it is
# CI-enforced with an audited emergency override - it can be skipped
# with `SKIP_TEST_BASELINE=1` (documented + logged above) or with
# `git commit --no-verify`, and it is absent in environments where the
# hook was never installed. The HARD merge gate is the CI mirror at
# .github/workflows/test-baseline-guard.yml (made a required status
# check via the branch-protection runbook in
# docs/audit/branch-protection-setup.md). Treat this hook as the local
# convenience copy of that authority, not a guarantee on its own.
#
# Installation:
#   cd server && npm run install-hooks
#
# This hook is a shared script at .githooks/pre-commit; the install
# script copies it to .git/hooks/pre-commit and chmods it executable.

set -euo pipefail

# ── Colour helpers (graceful fallback if TTY is not colour) ─────────
if [[ -t 2 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  BLUE=$'\033[0;34m'
  NC=$'\033[0m'
else
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  NC=""
fi

log()  { printf '%s[baseline-guard]%s %s\n' "$BLUE" "$NC" "$1" >&2; }
warn() { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$YELLOW" "$1" "$NC" >&2; }
fail() { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$RED" "$1" "$NC" >&2; }
ok()   { printf '%s[baseline-guard]%s %s%s%s\n' "$BLUE" "$NC" "$GREEN" "$1" "$NC" >&2; }

# ── Counter validation (fail CLOSED) ────────────────────────────────
# The vitest-derived counters (`actual_total`, `passing`) are extracted from
# vitest's text output with `grep -oE "[0-9]+"`. The capture is *shaped* like a
# non-negative integer, but two pathological inputs are still possible and both
# would corrupt the arithmetic guards downstream:
#
#   - a leading-zero string (e.g. "007") - historically a source of octal-parse
#     surprises in `(( ... ))`; we reject it for the same reason we reject a
#     leading-zero .test-baseline above; and
#   - an absurdly large value (e.g. a 19-digit string) that overflows bash's
#     signed-64-bit `(( ... ))` arithmetic and silently wraps (the macOS system
#     bash is 3.2), so a numeric `(( _val > MAX ))` guard CANNOT catch it - the
#     comparison itself overflows. Left unchecked, a wrapped-negative count would
#     turn a "passing < baseline" regression check into a false PASS.
#
# So before ANY arithmetic touches a counter, validate it here and fail CLOSED.
# The upper bound is enforced by DIGIT COUNT first (a value with more digits than
# COUNTER_MAX is unambiguously larger and must never reach (( ))); only a value
# already known to fit is compared numerically. A real suite never approaches
# 100,000,000 tests/files, so a legitimate run never trips this; only a
# parse-corrupted or adversarial value does. Args: <human-name> <value>.
#
# This MUST be invoked as a plain statement (`validate_counter NAME "$v"`), NOT
# inside a command substitution: bash 3.2 does not propagate an `exit` out of a
# `$(...)` subshell to abort the parent under `set -e`, which would fail OPEN.
COUNTER_MAX=100000000   # 9 digits; see digit-count guard below.
validate_counter() {
  local _name="$1" _val="$2"
  if ! [[ "$_val" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "$_name from vitest output is not a canonical integer, got: '$_val' - commit blocked"
    exit 1
  fi
  # Reject by digit count first (overflow-safe), then numerically for same-length
  # values. A value with MORE digits than COUNTER_MAX is definitely larger; a
  # value with the SAME digit count is compared with (( )), which is safe because
  # it is known to fit in 64-bit.
  if (( ${#_val} > ${#COUNTER_MAX} )) \
     || { (( ${#_val} == ${#COUNTER_MAX} )) && (( _val > COUNTER_MAX )); }; then
    fail "$_name from vitest output ($_val) exceeds the sane upper bound ($COUNTER_MAX) - commit blocked"
    printf '[baseline-guard]   This is almost certainly a parse-corrupted or adversarial value; refusing\n' >&2
    printf '[baseline-guard]   to run arithmetic on it (overflow could mask a regression).\n' >&2
    exit 1
  fi
  return 0
}

# ── Emergency override ───────────────────────────────────────────────
if [[ "${SKIP_TEST_BASELINE:-}" == "1" ]]; then
  # An accountable override REQUIRES a reason. Refuse a bare bypass: an
  # unexplained skip is exactly the unaudited shortcut this audit log exists to
  # prevent. `SKIP_REASON` must be a non-empty, non-whitespace string.
  skip_reason="${SKIP_REASON:-}"
  if [[ -z "${skip_reason//[[:space:]]/}" ]]; then
    fail "SKIP_TEST_BASELINE=1 was set WITHOUT a justification - override refused."
    printf '[baseline-guard]   An emergency override must be accountable. Re-run with a reason:\n' >&2
    printf '[baseline-guard]     SKIP_TEST_BASELINE=1 SKIP_REASON="why you are bypassing" git commit ...\n' >&2
    exit 1
  fi
  # Collapse newlines/tabs so a multi-line reason cannot corrupt the single-line
  # log record (each override is exactly one tab-delimited line).
  skip_reason=$(printf '%s' "$skip_reason" | tr '\n\t' '  ')
  warn "SKIP_TEST_BASELINE=1 - emergency override active"
  warn "This commit is being made without running the baseline guard."
  warn "Override is logged to .test-baseline-overrides.log for audit."
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  head_sha=$(git rev-parse HEAD 2>/dev/null || echo "pre-commit")
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown-branch")
  author=$(whoami 2>/dev/null || echo "unknown-user")
  repo_root_for_log=$(git rev-parse --show-toplevel)
  # Tab-delimited: timestamp <tab> sha <tab> branch <tab> author <tab> reason.
  # Append-only; union-merged on rebase via .gitattributes (DoE 3a/N-3).
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$timestamp" "$head_sha" "$branch" "$author" "$skip_reason" \
    >> "$repo_root_for_log/.test-baseline-overrides.log"
  exit 0
fi

# Resolve repo root (allows hook to run from any subdirectory).
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Gate 1: typecheck ────────────────────────────────────────────────
log "Gate 1/2: npm run typecheck"
if ! (cd server && npm run typecheck --silent > /tmp/sanctuary-precommit-tsc.log 2>&1); then
  fail "TYPECHECK FAILED - commit blocked"
  tail -40 /tmp/sanctuary-precommit-tsc.log >&2
  printf '\n' >&2
  fail "Fix all TypeScript errors before committing."
  printf '[baseline-guard] To override in an emergency: SKIP_TEST_BASELINE=1 git commit ...\n' >&2
  exit 1
fi
ok "Gate 1/2: typecheck clean."

# ── Gate 2: transform-error detection + test baseline ───────────────
log "Gate 2/2: npm test + transform-error detection + baseline check"

# Resolve the enforcement floor from the SOURCE THAT WILL BE COMMITTED - never the
# unstaged working tree (the bypass this guard closes).
#
# Why not the working tree: if we read .test-baseline off disk here, an author
# could raise it on disk (so passing == the on-disk number) WITHOUT staging it.
# Then the fail-above ratchet check below (passing > baseline) sees passing ==
# baseline and skips entirely, so the actually-committed floor stays stale and a
# later regression can hide under it. The on-disk edit isn't even part of the
# commit. So the floor must come from git's object store, not the working tree.
#
# The floor IN EFFECT for this commit is HEAD's committed blob
# (`HEAD:.test-baseline`). A STAGED raise is a *proposed* new floor and is
# validated separately, in the fail-above block, by comparing the staged blob
# (`:.test-baseline`) against HEAD and requiring a strict increase. Keeping the
# regression/trigger floor at HEAD avoids a false "regression" when a Linux-floor
# bump is staged that is (legitimately) below the higher local macOS passing count.
baseline_is_staged=""
if git diff --cached --name-only 2>/dev/null | grep -qx ".test-baseline"; then
  baseline_is_staged="yes"
fi

# Does this commit stage anything that could CHANGE the test count?
#
# The fail-above check below exists to stop a silent ratchet: new tests raising
# the passing count without the floor being raised to match. But on a macOS dev
# box the local passing count ALWAYS exceeds the Linux floor by the platform
# delta (macOS-gated suites that skip on Linux), so `passing > baseline` is the
# NORMAL resting state locally, not evidence of anything.
#
# That produced a real failure mode (observed 2026-07-18, PR #965): on a commit
# that touches no server code at all (a ROADMAP.md edit, a dev-script fix), the
# hook demanded the author "account for the drift" by raising .test-baseline -
# but there was nothing to account for. The correct Linux floor had not changed,
# and raising it to the local macOS count would set a floor Linux can never
# reach, breaking CI for everyone. The only way through was
# SKIP_TEST_BASELINE=1. A gate that must be routinely bypassed to do ordinary
# work stops being a gate, and its override log stops being a signal.
#
# So: scope the fail-above demand to commits that could plausibly have changed
# the count. Anything under server/ qualifies (test files obviously, but also
# src, package.json, and vitest config - all of which can move the count). A
# commit staging NOTHING under server/ cannot have added a test, so an excess
# over the floor there is platform delta by construction, and is reported as a
# warning instead of a block.
#
# What this deliberately does NOT relax:
#   - the fail-BELOW regression check still blocks unconditionally, on every
#     commit, regardless of what is staged;
#   - any commit touching server/ still owes the full accounting;
#   - the CI guard (.github/workflows/test-baseline-guard.yml) is UNCHANGED and
#     still enforces the floor exactly. It runs on ubuntu-latest, where local
#     == CI and no platform delta exists, so it is the authority this local hook
#     is only the fast convenience copy of.
server_code_staged=""
if git diff --cached --name-only 2>/dev/null | grep -qE '^server/'; then
  server_code_staged="yes"
fi

# `|| true`: under `set -o pipefail` a failing `git show` (e.g. no HEAD on the
# first-ever commit) would otherwise propagate non-zero through the command
# substitution and abort the hook under `set -e`. We want the empty-value handling
# below to run instead.
baseline=$(git show HEAD:.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
# First-ever commit of the file (no HEAD blob): treat the floor as 0 so the
# fail-above block requires the introducing value to be staged and validated.
if [[ -z "$baseline" ]]; then
  baseline=0
fi
if ! [[ "$baseline" =~ ^(0|[1-9][0-9]*)$ ]]; then
  fail "committed .test-baseline (HEAD:.test-baseline) is not a single integer, got: '$baseline'"
  exit 1
fi

# A .test-baseline must exist on disk for the repo to be in a sane state, but its
# CONTENT is intentionally NOT used for enforcement (see above). Missing-file is
# still worth flagging unless it is being introduced (staged) in this commit.
if [[ ! -f .test-baseline && -z "$baseline_is_staged" ]]; then
  fail ".test-baseline file missing at repo root"
  printf '[baseline-guard]   Create it with a single integer (the current passing count) and stage it.\n' >&2
  exit 1
fi

# Defense-in-depth diagnostic: if the working-tree file disagrees with the
# enforced (committed) floor, surface it. An UNSTAGED raise is exactly the bypass
# shape, so make it loud - it is being IGNORED for enforcement, by design.
if [[ -f .test-baseline ]]; then
  worktree_baseline=$(tr -d '[:space:]' < .test-baseline)
  if [[ "$worktree_baseline" =~ ^(0|[1-9][0-9]*)$ && "$worktree_baseline" != "$baseline" && -z "$baseline_is_staged" ]]; then
    warn "working-tree .test-baseline ($worktree_baseline) differs from the committed floor ($baseline) and is UNSTAGED."
    warn "The unstaged edit will NOT be committed and is IGNORED for enforcement. Stage it (git add .test-baseline) to make it count."
  fi
fi

# Run the test suite and capture BOTH output and exit code. Using
# `set +e` around the assignment means the subshell's non-zero exit
# does not abort this hook under `set -e` - we want to inspect the
# captured output to classify the failure before deciding how to
# report it.
set +e
test_output=$(cd server && npm test 2>&1)
test_exit=$?
set -e

# ── Check 2a: transform / collection failure classification ────────
#
# The 2026-04-10 incident (commit 4ac95830) was a parse error at
# vitest's transform step that caused test files to drop silently.
# The PRIMARY signal is vitest's exit code - if `npm test` returns
# non-zero, the commit MUST be blocked regardless of any substring
# parsing. The substring match then runs as a classifier to decide
# whether to name the error as the specific 4ac95830 failure class
# or as a generic test failure.
#
# Patterns covered (case-insensitive):
#
#   "transform failed"           - vite:esbuild plugin message
#                                  (e.g. "Transform failed with 1 error")
#   "transform error"            - alternate vitest transform message
#   "failed to parse"            - esbuild / swc parse error
#   "failed to collect"          - vitest collection failure
#   "failed to load source"      - vitest source-loading failure
#   "cannot find module"         - missing import or dependency
#   "Failed Suites"              - vitest summary header for
#                                  suite-level failures (shown when
#                                  a test file fails to register)
#
# Any match in combination with non-zero exit classifies the failure
# as a transform/collection error and points the reader at the
# 4ac95830 postmortem. A non-zero exit WITHOUT a matching substring
# is a generic test failure and is blocked with a simpler message.
TRANSFORM_ERROR_PATTERNS='(transform failed|transform error|failed to parse|failed to collect|failed to load source|cannot find module|failed suites)'

# Keep this classifier aligned with the CI mirror in
# .github/workflows/test-baseline-guard.yml. Vite 8 can emit a benign
# "failed to load source map" warning while the suite still runs cleanly;
# filtering that exact phrase prevents a false positive without weakening the
# real source-load, transform, parse, collect, missing-module, or failed-suite
# signatures. Both exit paths below consume this one result so they cannot
# drift apart.
classify_transform_errors() {
  local _output="$1"
  printf '%s\n' "$_output" \
    | grep -Eqi "$TRANSFORM_ERROR_PATTERNS" >/dev/null && \
    printf '%s\n' "$_output" \
      | grep -Ei "$TRANSFORM_ERROR_PATTERNS" \
      | grep -viE 'failed to load source map' || true
}

transform_error_hits=$(classify_transform_errors "$test_output")

if (( test_exit != 0 )); then
  if [[ -n "$transform_error_hits" ]]; then
    fail "TRANSFORM/COLLECTION ERROR DETECTED — commit blocked"
    printf '\n' >&2
    printf '%s\n' "$transform_error_hits" | head -20 >&2
    printf '\n' >&2
    fail "This is the specific failure class from commit 4ac95830:"
    printf '[baseline-guard]   a parse/transform error causing test files to fail at\n' >&2
    printf '[baseline-guard]   vitest collection time. See\n' >&2
    printf '[baseline-guard]   docs/audit/commit-4ac95830-postmortem.md\n' >&2
    exit 1
  fi
  fail "TEST SUITE FAILED (exit code $test_exit) - commit blocked"
  printf '\n' >&2
  echo "$test_output" | tail -40 >&2
  exit 1
fi

# Exit code was zero, but ALSO scan for transform-error substrings
# as defense-in-depth. In theory a vitest version could report the
# error without failing the run (unlikely but worth the extra line).
if [[ -n "$transform_error_hits" ]]; then
  fail "TRANSFORM/COLLECTION ERROR DETECTED (despite zero exit) — commit blocked"
  printf '\n' >&2
  printf '%s\n' "$transform_error_hits" | head -20 >&2
  printf '\n' >&2
  fail "This is the specific failure class from commit 4ac95830."
  printf '[baseline-guard]   See docs/audit/commit-4ac95830-postmortem.md\n' >&2
  exit 1
fi

# ── Check 2b: silent test file drop ─────────────────────────────────
#
# Delegates to scripts/gate2b-check.sh - the SAME implementation
# .github/workflows/test-baseline-guard.yml's Gate 2b calls. This hook used
# to keep its own copy of the "Test Files N passed (TOTAL)" parsing and the
# expected-vs-actual comparison; that second copy is exactly the kind of
# drift that let this hook and CI disagree on whether expected_files=0 was
# acceptable (this hook rejected it outright; the other copy did not) until
# both were unified into gate2b-check.sh, which now owns that refusal in one
# place. See that script for the vitest-own-discovery expected count
# (server/scripts/count-vitest-test-files.mjs, via `vitest list --filesOnly`)
# and its self-test (scripts/gate2b-self-test.sh).
GATE2B_LOG="$(mktemp)"
trap 'rm -f "$GATE2B_LOG"' EXIT
printf '%s\n' "$test_output" > "$GATE2B_LOG"

set +e
gate2b_output=$(bash scripts/gate2b-check.sh "$GATE2B_LOG" 2>&1)
gate2b_status=$?
set -e

# FAILURE MODE: gate2b-check.sh's own messages use GitHub Actions'
# "::error::" annotation prefix, which is meaningless outside Actions but
# harmless - it just prints as literal text here. Re-prefixing every line
# with this hook's own "[baseline-guard]" tag keeps the local output visually
# consistent with every other check in this script instead of leaving one
# check's output in a different voice.
while IFS= read -r gate2b_line; do
  printf '[baseline-guard] %s\n' "$gate2b_line" >&2
done <<< "$gate2b_output"

if (( gate2b_status != 0 )); then
  fail "SILENT TEST FILE DROP DETECTED (or an inconsistency in vitest's own file discovery) - commit blocked"
  printf '\n' >&2
  fail "This is the specific failure class from commit 4ac95830."
  printf '[baseline-guard]   See docs/audit/commit-4ac95830-postmortem.md\n' >&2
  exit 1
fi

# Recover actual_total (needed for the Gate 2/2 summary line below) from
# gate2b-check.sh's own output instead of re-parsing test_output a second
# time with a second copy of the same regex - that second copy is the exact
# shape of drift this delegation exists to remove, even for a cosmetic
# summary number.
actual_total=$(echo "$gate2b_output" | grep -oE "Files vitest loaded for the run:[[:space:]]+[0-9]+" | grep -oE "[0-9]+")
if [[ -z "$actual_total" ]]; then
  fail "Could not recover the test-file count from scripts/gate2b-check.sh output - internal error"
  exit 1
fi
# Validate before any arithmetic (fail CLOSED on non-canonical / overflow).
# gate2b-check.sh already validated this value itself; this is defense in
# depth for the LOCAL re-parse above, not a claim that gate2b-check.sh might
# be wrong.
validate_counter "Test Files count" "$actual_total"

# ── Check 2c: passing count >= baseline ─────────────────────────────
#
# Parse "Tests  N passed" (the "| M skipped" suffix is ignored).
passing=$(echo "$test_output" | grep -oE "Tests[[:space:]]+[0-9]+ passed" | grep -oE "[0-9]+" | head -1)
if [[ -z "$passing" ]]; then
  fail "Could not parse passing-test count from vitest output"
  echo "$test_output" | tail -30 >&2
  exit 1
fi
# Validate before any arithmetic (fail CLOSED on non-canonical / overflow).
validate_counter "passing-test count" "$passing"

if (( passing < baseline )); then
  fail "TEST BASELINE REGRESSION - commit blocked"
  printf '[baseline-guard]   Committed floor (HEAD:.test-baseline): %s\n' "$baseline" >&2
  printf '[baseline-guard]   Current passing count:                 %s\n' "$passing" >&2
  printf '[baseline-guard]   Regression: %s tests\n' "$((baseline - passing))" >&2
  printf '\n' >&2
  fail "Fix the regression, or update .test-baseline in a separate"
  fail "explicitly-scoped commit explaining the bump."
  exit 1
fi

# Fail-above WITHOUT an in-commit baseline bump. A passing count higher
# than the floor must be ACCOUNTED FOR - either by raising .test-baseline
# in this same commit, or it is a silent ratchet that lets a later
# regression hide under the stale floor (the extra passing tests mask the
# loss until the floor is finally bumped).
#
# Local-vs-CI note (coordinator baseline-floor rule): the floor is the
# LINUX CI passing count; a macOS dev box legitimately runs MORE tests
# than that floor (platform-specific suites), so requiring passing ==
# baseline locally would be impossible. The reconciliation: if the author
# RAISED .test-baseline in THIS commit (an UPWARD bump of the staged value
# over the previous committed value), the drift is accounted for and the
# commit passes even though local passing > the new (Linux) floor. If
# .test-baseline is NOT staged and passing > baseline, that is an
# unaccounted drift and the commit is blocked. The CI guard (which runs on
# Linux, where local == CI) enforces the exact floor.
#
# IMPORTANT (mirrors the CI guard's intent): merely STAGING .test-baseline is
# not enough - the staged value must be GREATER than the previously committed
# value. A flat re-stage (same number) or a LOWERED edit is NOT an accounting
# of the drift: it would let an author satisfy this gate while keeping the
# floor stale (or pushing it down so a real regression slips under it). So we
# compare the staged blob against HEAD's blob and require a strict increase.
#
# STRICT-UPWARD STAGED CHECK RUNS UNCONDITIONALLY (codex #571 round-2 fix): if
# .test-baseline is staged at all, validate it HERE, before the passing>baseline
# branch. Otherwise, when passing == the committed floor, a staged LOWERED value
# or a staged DELETION would skip the in-branch check below and quietly commit a
# weaker/missing floor that a future regression could hide under. Fresh locals
# (_sb/_pb) so the in-branch "drift accounted" message keeps its own vars.
if [[ -n "$baseline_is_staged" ]]; then
  _sb=$(git show :.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
  if ! [[ "$_sb" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "STAGED .test-baseline IS NOT A SINGLE INTEGER (or was deleted) - commit blocked"
    printf '[baseline-guard]   Staged value: %s\n' "'$_sb'" >&2
    printf '[baseline-guard] Override (emergency): SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
  _pb=$(git show HEAD:.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
  [[ "$_pb" =~ ^(0|[1-9][0-9]*)$ ]] || _pb=0
  if (( _sb <= _pb )); then
    fail "STAGED .test-baseline IS NOT AN UPWARD BUMP - commit blocked"
    printf '[baseline-guard]   Previously committed: %s\n' "$_pb" >&2
    printf '[baseline-guard]   Staged value:         %s\n' "$_sb" >&2
    printf '\n' >&2
    fail "A flat re-stage, a lowered edit, or a deletion is not an accounting of"
    fail "drift - it keeps the floor stale (or pushes it down so a regression"
    fail "slips under it). Raise it to the new Linux CI passing count and re-stage."
    printf '[baseline-guard] Override (emergency): SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
  # An OVER-RAISED staged floor (above the current passing count) is also invalid:
  # it poisons the NEXT commit (passing < floor -> fail-below blocks a clean commit)
  # and can mask a real regression up to the inflated number. The correct staged
  # value is the new LINUX CI passing count, which is <= local passing (a macOS box
  # legitimately runs MORE tests than the Linux floor), so a legitimate value never
  # trips this - only an inflated one does. (codex #571 r3 finding.)
  if (( _sb > passing )); then
    fail "STAGED .test-baseline ($_sb) EXCEEDS the current passing count ($passing) - commit blocked"
    printf '[baseline-guard]   An over-raised floor poisons the next commit and can mask a\n' >&2
    printf '[baseline-guard]   regression up to the inflated number. Set .test-baseline to the\n' >&2
    printf '[baseline-guard]   new LINUX CI passing count (<= your local passing), not higher.\n' >&2
    printf '[baseline-guard] Override (emergency): SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
fi
if (( passing > baseline )); then
  if [[ -z "$baseline_is_staged" ]]; then
    # Platform-delta case: nothing under server/ is staged, so this commit
    # cannot have added a test. The excess is the macOS-over-Linux delta, which
    # is the normal resting state on a dev box. Report it and allow; do NOT
    # demand a bump that would set a floor Linux can never reach.
    if [[ -z "$server_code_staged" ]]; then
      warn "Passing count ($passing) exceeds the committed floor ($baseline) by $((passing - baseline))."
      warn "This commit stages nothing under server/, so it cannot have added a test -"
      warn "treating the excess as the known macOS-over-Linux platform delta."
      warn "The floor is UNCHANGED at $baseline. Do NOT raise it to your local count:"
      warn "the floor is the LINUX CI passing count, and CI enforces it exactly."
      ok "Gate 2/2: $actual_total test files loaded, $passing tests passed (floor: $baseline, platform delta: $((passing - baseline)))."
      ok "All baseline-guard checks passed. Commit allowed."
      exit 0
    fi
    fail "TEST BASELINE DRIFTED ABOVE THE FLOOR - commit blocked"
    printf '[baseline-guard]   Committed floor (HEAD:.test-baseline): %s\n' "$baseline" >&2
    printf '[baseline-guard]   Current passing count:                 %s\n' "$passing" >&2
    printf '[baseline-guard]   Unaccounted above floor:               %s\n' "$((passing - baseline))" >&2
    printf '\n' >&2
    fail "Account for the drift IN THIS COMMIT: raise .test-baseline (by the"
    fail "number of NEW tests that run on Linux CI, per the baseline-floor"
    fail "rule - NOT to your local macOS count) and stage it"
    fail "(git add .test-baseline). A deferred bump lets a future regression"
    fail "hide under the stale floor."
    printf '[baseline-guard] To override in an emergency: SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi

  # .test-baseline IS staged - verify the staged value is a strict UPWARD
  # bump over the previously committed value. The staged content is the
  # `:.test-baseline` blob (the index); the previous committed content is
  # `HEAD:.test-baseline`. On the very first commit of the file there is no
  # HEAD blob, so the prior value is treated as 0 and any positive staged
  # value qualifies as an upward bump.
  staged_baseline=$(git show :.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
  if ! [[ "$staged_baseline" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "STAGED .test-baseline IS NOT A SINGLE INTEGER - commit blocked"
    printf '[baseline-guard]   Staged value: %s\n' "'$staged_baseline'" >&2
    exit 1
  fi
  prev_baseline=$(git show HEAD:.test-baseline 2>/dev/null | tr -d '[:space:]' || true)
  if ! [[ "$prev_baseline" =~ ^(0|[1-9][0-9]*)$ ]]; then
    prev_baseline=0
  fi
  if (( staged_baseline <= prev_baseline )); then
    fail "STAGED .test-baseline IS NOT AN UPWARD BUMP - commit blocked"
    printf '[baseline-guard]   Previously committed: %s\n' "$prev_baseline" >&2
    printf '[baseline-guard]   Staged value:         %s\n' "$staged_baseline" >&2
    printf '[baseline-guard]   Current passing:      %s\n' "$passing" >&2
    printf '\n' >&2
    fail "Staging .test-baseline only accounts for the drift if it RAISES the"
    fail "floor. A flat re-stage or a lowered edit is not an accounting - it"
    fail "keeps the floor stale (or pushes it down so a regression slips"
    fail "under it). Raise it to the new Linux CI passing count and re-stage"
    fail "(git add .test-baseline)."
    printf '[baseline-guard] To override in an emergency: SKIP_TEST_BASELINE=1 git commit ...\n' >&2
    exit 1
  fi
  ok "Passing count ($passing) exceeds the floor ($baseline); .test-baseline raised $prev_baseline -> $staged_baseline in this commit - drift accounted for (local may exceed the Linux floor)."
fi

ok "Gate 2/2: $actual_total test files loaded, $passing tests passed (baseline: $baseline)."
ok "All baseline-guard checks passed. Commit allowed."
exit 0
