#!/usr/bin/env bash
#
# Sanctuary pre-commit hook - fast tier (typecheck + changed-path tests)
# Copyright 2026 Erik Newton
# sanctuary-managed-hook: install-hooks.js owns this file
# SPDX-License-Identifier: Apache-2.0
#
# HISTORY (read before touching the scope split): this hook used to run the
# FULL suite (`npm test`, 15-20s at the time it was written) on every commit,
# enforcing the test-baseline floor and the silent-test-file-drop check
# documented in docs/audit/commit-4ac95830-postmortem.md. As the suite grew
# the wall-clock cost grew with it (measured 2026-09-26: 15 to 19 minutes for
# a full `npm test` run, not seconds), and a check that takes minutes on
# every commit gets routinely bypassed with --no-verify, which is worse than
# not having it. So the checks were split by cost:
#
#   - this hook (pre-commit, every commit): the CHEAP gates. Typecheck plus
#     `vitest related` scoped to the files this commit actually touches.
#     Budget: well under a minute.
#   - .githooks/pre-push (every push): the FULL gates. The complete `npm
#     test`, the test-baseline floor comparison, and the silent-test-file-drop
#     check, unchanged from what this hook used to run inline. Budget: the
#     full suite's own wall-clock time (15 to 19 minutes measured
#     2026-09-26).
#
# The failure mode this split is honest about: a fast-tier pass here is NOT
# proof the full suite is green, and does not touch or check
# .test-baseline. A commit can pass this hook and still be rejected at
# `git push` by the full-suite gate, or by the CI mirror
# (.github/workflows/test-baseline-guard.yml) if the push-time hook was
# bypassed or never installed. Someone reading a clean pre-commit run should
# not assume the baseline floor was checked - it was not; that happens at
# push time.
#
# Two gates, both must pass. The commit is blocked if either fails.
#
#   Gate 1: typecheck
#     Runs `npm run typecheck` in server/. Zero TypeScript errors
#     required. This is the cheap gate and runs first so the
#     expensive gate 2 never runs on a broken typecheck.
#
#   Gate 2: changed-path tests (`vitest related`) + transform-error scan
#     Determines the staged `.ts`/`.tsx` files under server/ (added, copied,
#     modified, or renamed - never a deleted file, which `vitest related`
#     cannot resolve), and runs `npx vitest related --run <those files>` in
#     server/: vitest's own dependency-graph feature, which maps each staged
#     source file to the test files that import it (transitively) and runs
#     only those, or runs a staged test file directly.
#
#     UNSTAGED-MODIFICATION REFUSAL (2026-09-26, MANDATORY): `vitest
#     related` reads the WORKTREE copy of the files it is given, not the
#     staged blob - so a staged file that also carries an unstaged edit
#     would be tested with content that is not what `git commit` is about
#     to record. This gate exists to test the blob being committed, so it
#     refuses the commit outright (see the check below) when any staged
#     path under server/ also has an unstaged modification, rather than
#     silently testing the wrong bytes.
#
#     WHAT THIS GATE COVERS, AND WHAT IT DEFERS (2026-09-26, corrected -
#     the previous wording claimed deletions were "covered" when in fact a
#     staged change consisting only of a deleted `*.test.ts` file, or of
#     `server/package.json`, `server/package-lock.json`,
#     `server/vitest.config*`, `server/tsconfig*.json`,
#     `server/tsup.config*`, or a plain `.js`/`.mjs` file under server/,
#     gives `vitest related` nothing to run and this gate falls through to
#     a silent no-op): this gate covers only staged `.ts`/`.tsx` files
#     under server/ that `vitest related` can resolve a module graph from.
#     A staged change that is ENTIRELY one or more of the kinds listed
#     above prints a one-line notice below that this fast tier cannot judge
#     it, and defers to `.githooks/pre-push` (the full suite) and the CI
#     floor guard - it does not block the commit on its own, since neither
#     typecheck nor a related-tests run is meaningful for those paths.
#
#     The output is redacted the same way the full suite's output is (see
#     scripts/redact-test-output.mjs) and scanned with the SAME
#     transform/collection-error classifier the full suite gate uses
#     (`classify_transform_errors` below) - this hook and
#     .githooks/pre-push must keep matching TRANSFORM_ERROR_PATTERNS values,
#     since both are pinned to the classifier regression tests in
#     server/test/scripts/precommit-transform-classifier.test.ts, which
#     extracts this hook's copy verbatim.
#
#     What this gate does NOT do, on purpose: it does not compare against
#     .test-baseline (there is no meaningful floor for an arbitrary subset of
#     tests), and it does not run scripts/gate2b-check.sh (silent-file-drop
#     detection needs vitest's own FULL-run file discovery to compare
#     against - see that script's header - and a related-tests subset run
#     has no such total to check). Both of those still run, unchanged, in
#     .githooks/pre-push.
#
# Runtime budget: well under a minute on a modern Mac (typecheck ~3s;
# `vitest related` over a small changed set is normally single-digit
# seconds - measured 2026-09-26 on a one-file change, see the packet report
# for the exact figure).
#
# This hook intentionally carries NO emergency override of its own (no
# SKIP_TEST_BASELINE handling here): there is no baseline check left in this
# gate to skip. Bypass this hook the ordinary git way, `git commit
# --no-verify`, same as any other pre-commit hook. The audited
# SKIP_TEST_BASELINE=1 / SKIP_REASON override now lives on
# .githooks/pre-push, where the expensive, baseline-bearing gate actually
# runs, and stays logged to .test-baseline-overrides.log there.
#
# Enforcement status (be precise - do NOT call this hook "not
# bypassable"): this LOCAL hook is the fast first line, but it is
# CI-enforced with an audited emergency override on the push-time hook - it
# can be skipped with `git commit --no-verify` (this hook) or
# `SKIP_TEST_BASELINE=1` / `git push --no-verify` (the push-time hook), and
# it is absent in environments where the hooks were never installed. The
# HARD merge gate is the CI mirror at
# .github/workflows/test-baseline-guard.yml (made a required status check
# via the branch-protection runbook in
# docs/audit/branch-protection-setup.md). Treat both local hooks as the fast
# convenience copy of that authority, not a guarantee on their own.
#
# Installation:
#   cd server && npm run install-hooks
#
# `install-hooks` installs BOTH .githooks/pre-commit (this file) and
# .githooks/pre-push into the real hooks directory git will execute from
# (see server/scripts/install-hooks.js for the worktree-vs-main-checkout
# resolution).
#
# This hook is a shared script at .githooks/pre-commit; the install script
# copies it to .git/hooks/pre-commit and chmods it executable.

set -euo pipefail

# ── Colour helpers (graceful fallback if TTY is not colour) ─────────
if [[ -t 2 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[0;33m'
  BLUE=$'\033[0;34m'
  NC=$'\033[0m'
else
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  NC=""
fi

log()  { printf '%s[fast-tier]%s %s\n' "$BLUE" "$NC" "$1" >&2; }
warn() { printf '%s[fast-tier]%s %s%s%s\n' "$BLUE" "$NC" "$YELLOW" "$1" "$NC" >&2; }
fail() { printf '%s[fast-tier]%s %s%s%s\n' "$BLUE" "$NC" "$RED" "$1" "$NC" >&2; }
ok()   { printf '%s[fast-tier]%s %s%s%s\n' "$BLUE" "$NC" "$GREEN" "$1" "$NC" >&2; }

# ── Counter validation (fail CLOSED) ────────────────────────────────
# RETAINED HERE DELIBERATELY even though this fast-tier gate no longer runs
# any threshold arithmetic on a vitest-derived counter itself (there is no
# baseline comparison in this hook any more - that logic, and its own live
# copy of this same validator, moved to .githooks/pre-push). This copy stays
# because server/test/scripts/precommit-counter-validation.test.ts extracts
# `validate_counter`/`COUNTER_MAX` verbatim from THIS file by path, so
# deleting it here would break that regression coverage rather than move it.
# The two copies (this one and .githooks/pre-push's) must not diverge in
# behavior; treat .githooks/pre-push's copy as the one that is actually load
# -bearing, and this one as the pinned artifact the self-test reads.
COUNTER_MAX=100000000   # 9 digits; see digit-count guard below.
validate_counter() {
  local _name="$1" _val="$2"
  if ! [[ "$_val" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "$_name is not a canonical integer, got: '$_val' - commit blocked"
    exit 1
  fi
  # Reject by digit count first (overflow-safe), then numerically for same-length
  # values. A value with MORE digits than COUNTER_MAX is definitely larger; a
  # value with the SAME digit count is compared with (( )), which is safe because
  # it is known to fit in 64-bit.
  if (( ${#_val} > ${#COUNTER_MAX} )) \
     || { (( ${#_val} == ${#COUNTER_MAX} )) && (( _val > COUNTER_MAX )); }; then
    fail "$_name ($_val) exceeds the sane upper bound ($COUNTER_MAX) - commit blocked"
    printf '[fast-tier]   This is almost certainly a parse-corrupted or adversarial value; refusing\n' >&2
    printf '[fast-tier]   to run arithmetic on it (overflow could mask a regression).\n' >&2
    exit 1
  fi
  return 0
}

# Resolve repo root (allows hook to run from any subdirectory).
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Gate 1: typecheck ────────────────────────────────────────────────
log "Gate 1/2: npm run typecheck"
if ! (cd server && npm run typecheck --silent > /tmp/sanctuary-precommit-tsc.log 2>&1); then
  fail "TYPECHECK FAILED - commit blocked"
  tail -40 /tmp/sanctuary-precommit-tsc.log >&2
  printf '\n' >&2
  fail "Fix all TypeScript errors before committing."
  exit 1
fi
ok "Gate 1/2: typecheck clean."

# ── Gate 2: changed-path tests (vitest related) ─────────────────────

# UNSTAGED-MODIFICATION REFUSAL (2026-09-26, MANDATORY): `vitest related`
# below is handed absolute paths and reads them off the WORKTREE, not the
# git index - there is no way to make vitest execute the staged blob
# directly. So if a staged file under server/ ALSO carries an unstaged
# edit, the worktree copy vitest would run is not the blob `git commit` is
# about to record; a pass here would prove nothing about the commit being
# made. Refuse before running anything, and name every offending path so
# the fix (stage the rest, or stash it) is obvious.
staged_server_paths=$(git diff --cached --name-only --diff-filter=ACMR -- server || true)
unstaged_server_paths=$(git diff --name-only -- server || true)
unstaged_conflict_paths=$(comm -12 \
  <(printf '%s\n' "$staged_server_paths" | sort) \
  <(printf '%s\n' "$unstaged_server_paths" | sort))

if [[ -n "$unstaged_conflict_paths" ]]; then
  fail "STAGED FILE(S) ALSO HAVE UNSTAGED EDITS - commit blocked"
  printf '\n' >&2
  fail "This gate tests the blob being committed. 'vitest related' reads the"
  fail "worktree copy of each file, so a path that is both staged and"
  fail "further modified would be tested with content that is not what this"
  fail "commit is about to record:"
  printf '\n' >&2
  printf '%s\n' "$unstaged_conflict_paths" | while IFS= read -r _p; do
    printf '[fast-tier]   %s\n' "$_p" >&2
  done
  printf '\n' >&2
  fail "Stage the remaining changes to these files, or stash/revert the"
  fail "unstaged edit, then commit again."
  exit 1
fi

# Staged .ts/.tsx files under server/, added/copied/modified/renamed only -
# a deleted file has nothing left for `vitest related` to resolve a module
# graph from, and excluding it is correct, not a gap: the test files that
# used to depend on a now-deleted source file are covered the moment they
# themselves change, and the full suite at push time covers everything
# regardless.
# Built with a plain while-read loop, not `mapfile`/`readarray`: the macOS
# system bash is 3.2 (mapfile/readarray are bash-4+ builtins), and this hook
# must run under whatever `#!/usr/bin/env bash` resolves to on a stock Mac.
staged_ts_files=()
while IFS= read -r _f; do
  [[ -n "$_f" ]] && staged_ts_files+=("$_f")
done < <(printf '%s\n' "$staged_server_paths" | grep -E '\.tsx?$' || true)

# DEFERRED-SCOPE NOTICE (2026-09-26, MANDATORY - see the header's
# WHAT THIS GATE COVERS section): a staged change under server/ that is a
# deleted `*.test.ts`/`*.test.tsx`, or one of the build/config files below,
# or a plain `.js`/`.mjs` file, gives `vitest related` nothing to resolve a
# module graph from. Name it explicitly rather than letting the commit pass
# with an unqualified "all checks passed" when this tier could not actually
# judge that change; pre-push (the full suite) and the CI floor guard are
# the gates that cover it.
deleted_test_files=$(git diff --cached --name-only --diff-filter=D -- server \
  | grep -E '\.test\.tsx?$' || true)
staged_config_files=$(printf '%s\n' "$staged_server_paths" \
  | grep -E '(^server/package\.json$|^server/package-lock\.json$|^server/vitest\.config\.[cm]?[jt]s$|^server/tsconfig(\..+)?\.json$|^server/tsup\.config\.[cm]?[jt]s$)' || true)
staged_plain_js_files=$(printf '%s\n' "$staged_server_paths" | grep -E '\.m?js$' || true)
undeferrable_paths=$(printf '%s\n%s\n%s\n' \
  "$deleted_test_files" "$staged_config_files" "$staged_plain_js_files" | grep -v '^$' || true)

if [[ -n "$undeferrable_paths" ]]; then
  log "Gate 2/2 notice: the fast tier cannot judge these staged path(s) (no .ts/.tsx module graph to run 'vitest related' against):"
  printf '%s\n' "$undeferrable_paths" | while IFS= read -r _p; do
    printf '[fast-tier]   %s\n' "$_p" >&2
  done
  log "pre-push (the full suite) and the CI floor guard are the gates for these paths."
fi

if (( ${#staged_ts_files[@]} == 0 )); then
  log "Gate 2/2: no staged .ts/.tsx files under server/ - nothing for vitest related to run."
  ok "All fast-tier checks passed. Commit allowed."
  exit 0
fi

log "Gate 2/2: npx vitest related --run (${#staged_ts_files[@]} staged file(s)) + transform-error scan"

abs_staged_files=()
for f in "${staged_ts_files[@]}"; do
  abs_staged_files+=("$repo_root/$f")
done

set +e
related_output=$(cd server && npx vitest related --run "${abs_staged_files[@]}" 2>&1 \
  | node ../scripts/redact-test-output.mjs)
related_exit=$?
set -e

# ── Transform/collection classifier ─────────────────────────────────
# IDENTICAL to the classifier .githooks/pre-push runs over the full suite's
# output (both must keep matching TRANSFORM_ERROR_PATTERNS -
# server/test/scripts/precommit-transform-classifier.test.ts pins THIS
# file's copy verbatim, and .githooks/pre-push carries its own copy that
# must not drift from this one). See that hook for the full pattern-by-
# pattern rationale; this is the same signature list from commit 4ac95830.
TRANSFORM_ERROR_PATTERNS='(transform failed|transform error|failed to parse|failed to collect|failed to load source|cannot find module|failed suites)'

classify_transform_errors() {
  local _output="$1"
  printf '%s\n' "$_output" \
    | grep -Eqi "$TRANSFORM_ERROR_PATTERNS" >/dev/null && \
    printf '%s\n' "$_output" \
      | grep -Ei "$TRANSFORM_ERROR_PATTERNS" \
      | grep -viE 'failed to load source map' || true
}

transform_error_hits=$(classify_transform_errors "$related_output")

if (( related_exit != 0 )); then
  if [[ -n "$transform_error_hits" ]]; then
    fail "TRANSFORM/COLLECTION ERROR DETECTED - commit blocked"
    printf '\n' >&2
    printf '%s\n' "$transform_error_hits" | head -20 >&2
    printf '\n' >&2
    fail "This is the specific failure class from commit 4ac95830:"
    printf '[fast-tier]   a parse/transform error causing test files to fail at\n' >&2
    printf '[fast-tier]   vitest collection time. See\n' >&2
    printf '[fast-tier]   docs/audit/commit-4ac95830-postmortem.md\n' >&2
    exit 1
  fi
  fail "CHANGED-PATH TESTS FAILED (vitest related exit code $related_exit) - commit blocked"
  printf '\n' >&2
  echo "$related_output" | tail -40 >&2
  printf '\n' >&2
  fail "This runs only the tests related to your staged files. The full suite"
  fail "(with the baseline floor) runs at push time via .githooks/pre-push."
  exit 1
fi

# Exit code was zero, but ALSO scan for transform-error substrings as
# defense-in-depth - a vitest version could in principle report the error
# without failing the run.
if [[ -n "$transform_error_hits" ]]; then
  fail "TRANSFORM/COLLECTION ERROR DETECTED (despite zero exit) - commit blocked"
  printf '\n' >&2
  printf '%s\n' "$transform_error_hits" | head -20 >&2
  printf '\n' >&2
  fail "This is the specific failure class from commit 4ac95830."
  printf '[fast-tier]   See docs/audit/commit-4ac95830-postmortem.md\n' >&2
  exit 1
fi

ok "Gate 2/2: changed-path tests passed for ${#staged_ts_files[@]} staged file(s)."
ok "All fast-tier checks passed. Commit allowed."
printf '[fast-tier] Note: the full suite and the .test-baseline floor are NOT checked here -\n' >&2
printf '[fast-tier] that runs at push time via .githooks/pre-push.\n' >&2
exit 0
