{
  "name": "sanctuary-framework-root",
  "private": true,
  "description": "Sanctuary repository root. Delegation surface for the menubar workspace. The canonical published package lives in server/.",
  "scripts": {
    "lint": "npm --prefix server run lint",
    "typecheck": "npm --prefix server run typecheck",
    "test": "npm --prefix server test",
    "check:release-dependency-pins": "node scripts/check-release-dependency-pins.mjs",
    "synthetic-coverage": "server/node_modules/.bin/tsx scripts/synthetic-coverage/run.ts",
    "synthetic-coverage:parity": "server/node_modules/.bin/tsx scripts/synthetic-coverage/parity-cli.ts",
    "synthetic-coverage:gate-a": "server/node_modules/.bin/tsx scripts/synthetic-coverage/rollup-cli.ts",
    "synthetic-coverage:baseline": "server/node_modules/.bin/tsx scripts/synthetic-coverage/gen-coverage-baseline.ts",
    "menubar:dev": "cd menubar && npm run tauri:dev",
    "menubar:build": "cd menubar && npm run tauri:build",
    "menubar:setup": "cd menubar && npm install",
    "cli-audit-inventory": "server/node_modules/.bin/tsx server/scripts/cli-audit-write-inventory.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
