#!/usr/bin/env expect
#
# arm-expect.exp - drive the exclusive-egress arm through its TTY confirmation.
#
# Arming asks for an interactive confirmation on a real terminal, which is
# correct: it is a destructive, host-wide change and a human should have to say
# so. An unattended loop still needs to exercise that exact code path rather
# than some bypass, so expect supplies the confirmation over a pty. Nothing
# about the product's confirmation gate is weakened or skipped; the loop just
# answers it.
#
# Every argument has ALREADY passed the rails in run-loop.sh before this script
# is invoked, and the wrapper re-runs the full rail gauntlet on its own
# arguments regardless. This script adds no trust.
#
# It passes a RUN ID, not a path. The wrapper composes the storage path itself
# under a root-owned base it compiled in, so there is no path here for this
# script to get wrong.
#
# Usage:
#   arm-expect.exp <wrapper> <run-id> <operator-account> <agent-account> <agent-uid>

set timeout 300

if {[llength $argv] != 5} {
    puts "arm-expect.exp: expected 5 arguments, got [llength $argv]"
    exit 2
}

set wrapper       [lindex $argv 0]
set run_id        [lindex $argv 1]
set operator      [lindex $argv 2]
set agent_account [lindex $argv 3]
set agent_uid     [lindex $argv 4]

# Refuse outright rather than pass a suspicious value through to a root-run
# wrapper. The wrapper would reject these too; failing here makes the loop log
# say which layer noticed.
# Lowercase only, matching rails_assert_run_id: the drill hosts' APFS volume is
# case-insensitive, so `A` and `a` are two ids and one directory.
if {![regexp {^[a-z0-9][a-z0-9._-]*$} $run_id]} {
    puts "arm-expect.exp: run id is not a plain lowercase identifier: $run_id"
    exit 2
}
if {![regexp {^[a-z_][a-z0-9_-]*$} $operator] || $operator eq "root"} {
    puts "arm-expect.exp: bad operator account: $operator"
    exit 2
}
if {![regexp {^[a-z_][a-z0-9_-]*$} $agent_account]} {
    puts "arm-expect.exp: bad agent account: $agent_account"
    exit 2
}
if {![regexp {^[1-9][0-9]*$} $agent_uid]} {
    puts "arm-expect.exp: agent uid must be a positive integer: $agent_uid"
    exit 2
}

# `-n`: never prompt for a password. The NOPASSWD grant covers this exact
# wrapper path, so a prompt here means the grant is missing or does not apply,
# and an unattended run must FAIL FAST on that rather than sit at a password
# prompt until the timeout burns the night.
spawn sudo -n $wrapper arm \
    --run-id $run_id \
    --operator-account $operator \
    --agent-account $agent_account \
    --agent-uid $agent_uid

# ANCHORED TO THE WRAPPER'S OWN TOKENS (round-3 L4). This used to match
# `(?i)refusing`, so ANY benign product line containing the word "refusing"
# mid-arm aborted the leg -- and aborted it by `exit 1` without waiting, leaving
# the spawned `sudo` child running. The wrapper emits exactly two refusal
# shapes and they are both machine tokens, so those are what this matches.
#
# ROUND-5 M4 -- AND THIS IS A SAFETY FIX, NOT A CORRECTNESS ONE.
#
# The generic branch here used to be `-re {(?i)\(y/n\)|\[y/N\]|continue\?}` with
# an `exp_continue`, i.e. it answered YES to ANY question that looked like a
# yes/no question, an unbounded number of times, while driving a ROOT-run
# operation whose effects are HOST-WIDE and not fortress-scoped: the pf anchor,
# the LaunchDaemons, the gate service account. A future product prompt of the
# shape "a gate is already armed for uid N; tear it down? (y/n)" would have got
# an unattended `y` on a machine that may be running something else entirely.
#
# An autonomous loop that meets a question it was not designed for must STOP,
# not consent. So the only prompts answered are the EXACT texts this drill
# expects, and anything else that looks like a confirmation is a hard failure
# with the prompt text in the log so the morning read says which question
# appeared. The list is short on purpose; adding to it is a decision somebody
# makes deliberately, having looked at the new prompt.
#
# The one expected prompt today is `orchestrate.ts`'s single safety confirm:
#   "Proceed with account creation and arming? [y/N] "
# and `server/test/drill-loop/product-identifiers.test.ts` pins this pattern to
# that literal, so a REWORDING goes red in CI rather than stopping the night at
# an unrecognised question at 3am.
#
# A `type ARM to confirm` branch used to sit below, answering a prompt that
# occurs NOWHERE in the product. It is gone rather than kept "just in case":
# an allowlist with a speculative entry is not an allowlist, and this file's
# whole correction is that a loop meeting a question it was not designed for
# stops instead of consenting. Round 2's `--endpoint` finding and round 3's
# `--passphrase-file` finding were both this shape.
set expected_arm_prompt {Proceed with account creation and arming\? \[y/N\]}

expect {
    -re {WRAPPER=REJECT|RAILS_REJECT:} {
        puts "\narm-expect.exp: the wrapper refused; not answering any prompt"
        exit 1
    }
    -re {sudo: a password is required|sudo: no tty present} {
        puts "\narm-expect.exp: the NOPASSWD grant for the wrapper is missing; failing fast rather than burning the night at a prompt"
        exit 1
    }
    -re $expected_arm_prompt {
        send "y\r"
        exp_continue
    }
    -re {(?i)\(y/n\)|\[y/n\]|continue\?|type .?ARM.? to confirm} {
        puts "\narm-expect.exp: an UNRECOGNISED confirmation prompt appeared during a root-run, host-wide arm; refusing to answer it"
        puts "prompt context: $expect_out(buffer)"
        # Close the pty rather than walking away from it. Leaving a root-run
        # arm parked at an unanswered prompt is how a half-applied host-wide
        # change survives the night; EOF on its stdin makes it abort.
        catch {exp_close}
        catch {exp_wait}
        exit 1
    }
    timeout {
        puts "\narm-expect.exp: timed out waiting for the arm to complete"
        exit 1
    }
    eof
}

catch wait result
set exit_status [lindex $result 3]
exit $exit_status
