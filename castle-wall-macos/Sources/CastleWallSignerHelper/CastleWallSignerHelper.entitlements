<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the root signer helper LaunchDaemon.

  Intentionally minimal: a Developer-ID SMAppService daemon needs hardened
  runtime (applied via `codesign --options runtime`) and no special entitlement
  to publish a mach service or run as root. Keep it empty so AMFI does not
  require a provisioning profile to grant a restricted key. If the console drill
  shows SMAppService stuck (§9 step 0/1), the entitlement/profile pairing is the
  first thing to revisit — do NOT add a restricted key here without a matching
  profile, which would fail-closed the launch.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
