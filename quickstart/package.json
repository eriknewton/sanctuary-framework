{
  "name": "@sanctuary-framework/quickstart",
  "version": "0.2.0",
  "description": "Zero-friction agent onboarding for Sanctuary Framework. Generate a local Ed25519 identity in seconds and, only if you choose, publish a signed agent profile to Verascore.",
  "type": "module",
  "bin": {
    "sanctuary-quickstart": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --test test/*.test.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "sanctuary",
    "sovereignty",
    "agent",
    "ed25519",
    "did",
    "verascore",
    "mcp"
  ],
  "author": "Erik Newton",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eriknewton/sanctuary-framework.git",
    "directory": "quickstart"
  },
  "homepage": "https://github.com/eriknewton/sanctuary-framework#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
