# Install-time hardening (engineering-practice ledger item E7, 2026-09-15).
# Mirrors server/.npmrc. The repo root has no dependencies and no lockfile
# (package.json here is a pure delegation surface to server/ and menubar/),
# so this has no installs to affect today; it is set so any future root
# dependency is covered by the same install-time control without a
# separate decision.
#
# ignore-scripts is deliberately NOT set here: server/package.json runs
# `npm run build` from a `pretest` lifecycle script, and .npmrc's
# ignore-scripts suppresses ALL lifecycle scripts, first-party pre/post
# hooks included, not just third-party install scripts , it would make
# `npm test` silently skip the build and run against a stale or missing
# dist everywhere (pre-commit hook, CI). The install-time control instead
# lives on individual `npm ci` invocations (`--ignore-scripts`, see
# .github/workflows/ci.yml), which only suppresses THIRD-PARTY dependency
# install scripts; first-party scripts invoked via `npm test`/`npm run`
# are unaffected because those are not `npm ci`.
#
# allow-git=none (npm >=11 config; docs:
# https://docs.npmjs.com/cli/v11/using-npm/config#allow-git): disables
# resolving dependencies through git references; every dependency in this
# repo is pinned to a registry version.
allow-git=none
