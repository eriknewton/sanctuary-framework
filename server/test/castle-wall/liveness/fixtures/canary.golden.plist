<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.sanctuaryprotocol.castle-wall.canary</string>
	<key>UserName</key>
	<string>sanctuary-agent-fixture</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/curl</string>
		<string>-q</string>
		<string>--noproxy</string>
		<string>*</string>
		<string>--retry</string>
		<string>0</string>
		<string>--output</string>
		<string>/dev/null</string>
		<string>--silent</string>
		<string>--connect-timeout</string>
		<string>10</string>
		<string>--max-time</string>
		<string>10</string>
		<string>http://192.0.2.254:9/</string>
	</array>
	<key>StartInterval</key>
	<integer>180</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>EnvironmentVariables</key>
	<dict/>
</dict>
</plist>
