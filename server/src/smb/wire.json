{
  "$comment": "THE SMB wire source; must match loaders wire.ts and castle-wall-daemon/src/smb/wire.rs. All fields required; no unknown fields. Decimal integers are strings, including D7 version/port under section 4 item 2. unconfirmed is an empty presence-marker object; identity and err_ino remain in r_record and prepared. String bounds use UTF-8 bytes.",
  "schemas": {
    "decimal": {
      "type": "decimal",
      "max": "18446744073709551615",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "request_id": {
      "type": "decimal",
      "min": "1",
      "max": "18446744073709551615",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "hex128": {
      "type": "string",
      "min": "ID_HEX_CHARS",
      "max": "ID_HEX_CHARS",
      "chars": "0123456789abcdef",
      "pattern": "^[0-9a-f]{32}$"
    },
    "I": {
      "ref": "hex128"
    },
    "boot_id": {
      "ref": "hex128"
    },
    "K": {
      "ref": "hex128"
    },
    "MACHINE_ID": {
      "ref": "hex128"
    },
    "class": {
      "type": "string",
      "min": 1,
      "max": "CLASS_MAX_BYTES",
      "chars": "abcdefghijklmnopqrstuvwxyz0123456789_.-",
      "pattern": "^[a-z0-9_.-]{1,64}$"
    },
    "digest": {
      "type": "string",
      "min": 64,
      "max": 64,
      "chars": "0123456789abcdef"
    },
    "T": {
      "ref": "hex128"
    },
    "P": {
      "ref": "hex128"
    },
    "Q": {
      "ref": "hex128"
    },
    "person": {
      "ref": "hex128"
    },
    "T_view": {
      "ref": "hex128"
    },
    "text": {
      "type": "string",
      "min": 1,
      "max": "STRING_MAX_BYTES"
    },
    "placeholder": {
      "type": "string",
      "min": 1,
      "max": "STRING_MAX_BYTES",
      "prefix": "PLACEHOLDER_PREFIX",
      "suffix": "hex128"
    },
    "activation_state": {
      "enum": [
        "LIVE",
        "STARTING",
        "STOP_UNCONFIRMED",
        "STOPPING",
        "PREPARED",
        "NONE",
        "RESIDUE"
      ]
    },
    "json": {
      "type": "json"
    },
    "integer": {
      "type": "integer"
    },
    "request_envelope": {
      "type": "object",
      "fields": {
        "kind": "text",
        "id": "request_id"
      }
    },
    "reply_envelope": {
      "type": "object",
      "fields": {
        "id": "request_id",
        "ok": {
          "const": true
        }
      }
    },
    "error_envelope": {
      "type": "object",
      "fields": {
        "id": "request_id",
        "ok": {
          "const": false
        },
        "error": {
          "enum": [
            "refused",
            "malformed",
            "unavailable"
          ]
        }
      }
    },
    "r_record": {
      "type": "object",
      "fields": {
        "boot_id": "boot_id",
        "I": "I",
        "C": "decimal",
        "unit_name": "text",
        "K": "K",
        "in_ino": "decimal",
        "out_ino": "decimal",
        "err_ino": "decimal",
        "state": {
          "enum": [
            "live",
            "stopping"
          ]
        }
      }
    },
    "prepared": {
      "type": "object",
      "fields": {
        "K": "K",
        "in_ino": "decimal",
        "out_ino": "decimal",
        "err_ino": "decimal"
      }
    },
    "start_ticket": {
      "type": "object",
      "fields": {
        "K": "K"
      }
    },
    "unconfirmed": {
      "type": "object",
      "fields": {}
    },
    "wall_status": {
      "type": "object",
      "fields": {
        "instance_id": "hex128",
        "digest": "digest"
      }
    },
    "decision": {
      "type": "object",
      "fields": {
        "Q": "Q",
        "digest": "digest",
        "I": "I",
        "C": "decimal",
        "cookie": "decimal",
        "value": {
          "enum": [
            "approve",
            "deny"
          ]
        }
      }
    },
    "owner_enroll_request": {
      "type": "object",
      "fields": {
        "version": {
          "const": "1"
        },
        "person": "person",
        "role": {
          "const": "owner"
        },
        "code_hash": "digest",
        "expires": "decimal"
      }
    },
    "vault_entry": {
      "type": "object",
      "fields": {
        "placeholder": "placeholder",
        "agent_uid": "decimal",
        "host": "text",
        "header": "text",
        "value_b64": {
          "type": "base64",
          "max": "MAX_VAULT_VALUE_BYTES"
        }
      }
    },
    "vault_plaintext": {
      "type": "object",
      "fields": {
        "version": {
          "const": "1"
        },
        "entries": {
          "type": "array",
          "items": "vault_entry",
          "max": "ARRAY_MAX_ITEMS"
        }
      }
    },
    "route": {
      "type": "object",
      "fields": {
        "method": {
          "const": "POST"
        },
        "path": "text",
        "class": "class"
      }
    },
    "destination_host": {
      "type": "object",
      "fields": {
        "host": "text",
        "port": {
          "const": "443"
        },
        "header": "text",
        "placeholder": "placeholder",
        "routes": {
          "type": "array",
          "items": "route",
          "max": "ARRAY_MAX_ITEMS"
        }
      }
    },
    "destinations_body": {
      "type": "object",
      "fields": {
        "version": {
          "const": "1"
        },
        "fortress_id": "text",
        "generation": "decimal",
        "issued_at": "decimal",
        "expires_at": "decimal",
        "hosts": {
          "type": "array",
          "items": "destination_host",
          "max": "ARRAY_MAX_ITEMS"
        }
      }
    },
    "manifest_signature": {
      "type": "object",
      "fields": {
