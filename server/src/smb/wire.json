        "signature_b64url": {
          "type": "base64url",
          "max": 64
        }
      }
    },
    "destinations_file": {
      "type": "object",
      "fields": {
        "body": "destinations_body",
        "signature": "manifest_signature"
      }
    },
    "fifo_in": {
      "type": "object",
      "fields": {
        "T_view": "T_view",
        "body": "json"
      }
    },
    "fifo_result": {
      "type": "object",
      "fields": {
        "type": {
          "const": "result"
        },
        "data_b64": {
          "type": "base64",
          "max": "TASK_OUT_FRAME_MAX"
        }
      }
    },
    "fifo_end": {
      "type": "object",
      "fields": {
        "type": {
          "const": "end"
        },
        "outcome": {
          "enum": [
            "done",
            "failed"
          ]
        }
      }
    },
    "fifo_refused": {
      "type": "object",
      "fields": {
        "type": {
          "const": "refused"
        },
        "check": {
          "enum": [
            "workspace",
            "hidden_path",
            "proc_view"
          ]
        }
      }
    },
    "fifo_out": {
      "oneOf": [
        "fifo_result",
        "fifo_end",
        "fifo_refused"
      ]
    },
    "activate.prepare.request": {
      "type": "object",
      "extends": "request_envelope",
      "fields": {
        "kind": {
          "const": "prepare"
        }
      }
    },
    "activate.prepare.reply": {
      "type": "object",
      "extends": "reply_envelope",
      "fields": {
        "K": "K",
