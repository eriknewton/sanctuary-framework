        "K": "K"
      }
    },
    "activate.start.reply": {
      "type": "object",
      "extends": "reply_envelope",
      "fields": {
        "I": "I",
        "C": "decimal"
      }
    },
    "activate.stop.request": {
      "type": "object",
      "extends": "request_envelope",
      "fields": {
        "kind": {
          "const": "stop"
        }
      }
    },
    "activate.stop.reply": {
      "type": "object",
      "extends": "reply_envelope",
      "fields": {
        "state": "activation_state"
      }
    },
    "activate.status.request": {
      "type": "object",
      "extends": "request_envelope",
      "fields": {
        "kind": {
          "const": "status"
        }
      }
    },
    "activate.status.reply": {
      "type": "object",
      "extends": "reply_envelope",
