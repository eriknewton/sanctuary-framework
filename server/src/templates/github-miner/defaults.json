{
  "egress": [
    {
      "destination": "api.github.com",
      "methods": ["GET"],
      "comment": "GitHub REST API endpoint for repository, issue, and PR data."
    }
  ],
  "budgets": {
    "daily": { "amount": 100000, "unit": "tokens" },
    "monthly": { "amount": 5, "unit": "usd" }
  },
  "retention": {
    "windows": {
      "memory": { "max_age_seconds": 2592000 },
      "outputs": { "max_age_seconds": 7776000 }
    }
  }
}
