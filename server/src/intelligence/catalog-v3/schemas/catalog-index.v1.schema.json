{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sanctuary:schema:catalog-index-envelope:v1",
  "title": "Sanctuary Signed Catalog Index Segment V1",
  "$comment": "Structural prefilter only. Admission requires verifyAndParseSignedCatalogIndexSegmentV1; runtime validation additionally enforces cross-field ranges, key epochs, uniqueness, and signature verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signature", "signing_key_id"],
  "properties": {
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "index_version", "previous_index_body_sha256", "segment_number", "segment_base_index_version", "first_catalog_version", "highest_catalog_version", "issued_at", "entries"],
      "properties": {
        "schema": { "const": "sanctuary.model-catalog-index.v1" },
        "index_version": { "$ref": "#/$defs/version" },
        "previous_index_body_sha256": { "oneOf": [{ "$ref": "#/$defs/nonzeroDigest" }, { "type": "null" }] },
        "segment_number": { "$ref": "#/$defs/version" }, "segment_base_index_version": { "$ref": "#/$defs/version" },
        "first_catalog_version": { "$ref": "#/$defs/version" }, "highest_catalog_version": { "$ref": "#/$defs/version" },
        "issued_at": { "type": "string", "pattern": "^(?:(?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))|(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$" },
        "entries": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/entry" } }
      },
      "allOf": [
        { "if": { "properties": { "index_version": { "const": 1 } }, "required": ["index_version"] }, "then": { "properties": { "previous_index_body_sha256": { "type": "null" } } }, "else": { "properties": { "previous_index_body_sha256": { "$ref": "#/$defs/nonzeroDigest" } } } }
      ]
    },
    "signature": { "type": "string", "pattern": "^(?!A{86}(?![\\s\\S]))[A-Za-z0-9_-]{85}[AQgw](?![\\s\\S])" },
    "signing_key_id": { "type": "string", "pattern": "^cat-epoch-[1-9][0-9]{0,8}(?![\\s\\S])" }
  },
  "$defs": {
    "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "positiveSafeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonzeroDigest": { "type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$" },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_version", "catalog_release_id", "catalog_asset_id", "envelope_sha256", "body_sha256", "catalog_key_epoch"],
      "properties": { "catalog_version": { "$ref": "#/$defs/version" }, "catalog_release_id": { "$ref": "#/$defs/positiveSafeInteger" }, "catalog_asset_id": { "$ref": "#/$defs/positiveSafeInteger" }, "envelope_sha256": { "$ref": "#/$defs/nonzeroDigest" }, "body_sha256": { "$ref": "#/$defs/nonzeroDigest" }, "catalog_key_epoch": { "$ref": "#/$defs/version" } }
    }
  }
}
