{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "./dist-typecheck",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "test/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-typecheck"]
}
