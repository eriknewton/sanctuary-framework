#!/bin/sh
# The hard limit prevents another same-user process restoring dump permission.
ulimit -S -c 0 || exit 1
ulimit -H -c 0 || exit 1
# /bin/sh and /usr/bin/perl are OS-trusted interpreters on both workstations.
# Resolve only fixed candidates before handing Node the key fd: root owns every
# link, resolved file and ancestor; mode/ACL checks exclude invoking-user writes
# (root itself is trusted). Execute the
# resolved path so a user-managed alias cannot replace it between check and exec.
# User-writable package-manager installs deliberately fail closed.
unset NODE_OPTIONS NODE_PATH LD_PRELOAD LD_LIBRARY_PATH DYLD_INSERT_LIBRARIES DYLD_LIBRARY_PATH
unset PERL5OPT PERL5LIB PERLLIB
exec /usr/bin/perl -T -e '
use strict;
use warnings;
use Fcntl qw(:mode);
use filetest "access";
sub trusted_entry {
    my ($path) = @_;
    my @s = lstat($path); # POSIX stat slots: mode = 2, owner uid = 4.
    return 0 unless @s && $s[4] == 0;
    # Symlink permissions are inert; its already-verified parent protects replacement.
    return 1 if S_ISLNK($s[2]);
    # 0022 selects group/other write; filetest access asks the kernel about ACLs.
    # Root is trusted, but ordinary invokers must not be able to rewrite this inode.
    return ($s[2] & 0022) == 0 && ($> == 0 || !-w $path);
}
sub trusted_path {
    my ($path) = @_;
    return unless $path =~ m{\A/};
    my @pending = split m{/}, $path;
    my $resolved = "/";
    my $links = 0;
    # Match the Linux traversal ceiling; finite expansion also refuses link cycles.
    my $max_links = 40;
    return unless trusted_entry($resolved);
    while (@pending) {
        my $part = shift @pending;
        next if $part eq "" || $part eq ".";
        if ($part eq "..") {
            $resolved =~ s{/[^/]+$}{};
            $resolved = "/" if $resolved eq "";
            next;
        }
        my $next = ($resolved eq "/" ? "" : $resolved) . "/" . $part;
        return unless trusted_entry($next);
        if (-l $next) {
            return if ++$links > $max_links;
            my $target = readlink($next);
            return unless defined($target);
            # Inspect every hop before following it: realpath alone hides replaceable
            # intermediate links, even when the final executable is root-custodied.
            $resolved = "/" if $target =~ m{\A/};
            unshift @pending, split m{/}, $target;
        } else {
            return if @pending && !-d $next;
            $resolved = $next;
        }
    }
    return $resolved;
}
my @candidates = $^O eq "darwin" ? qw(/usr/local/bin/node /opt/homebrew/bin/node)
               : $^O eq "linux" ? qw(/usr/bin/node /usr/local/bin/node) : ();
for my $candidate (@candidates) {
    my $node = trusted_path($candidate);
    next unless defined($node) && -f $node && -x $node;
    # Untaint only after custody verification; taint mode excludes Perl env hooks.
    ($node) = $node =~ m{\A(/[^\0\r\n]+)\z};
    next unless defined($node);
    $ENV{PATH} = "/usr/bin:/bin";
    delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};
    # Arguments stay literal (no shell); the signing CLI validates their grammar.
    my @args = map { /\A(.*)\z/s; $1 } @ARGV;
    exec {$node} $node, @args;
    exit 1;
}
exit 1;
' -- --input-type=module -e '
import { realpathSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { pathToFileURL } from "node:url";
try {
  const entry = resolve(dirname(realpathSync(process.argv[1])), "../dist/linux-policy-sign.js");
  const { main } = await import(pathToFileURL(entry).href);
  await main(process.argv.slice(2));
} catch {
  console.error("sanctuary-linux-policy-sign: signing refused");
  process.exitCode = 1;
}
' "$0" "$@"
