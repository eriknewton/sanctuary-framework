# Install-time hardening (engineering-practice ledger item E7, 2026-09-15).
#
# ignore-scripts is deliberately NOT set here. server/package.json's
# `pretest` script runs `npm run build`, and `prepublishOnly` runs its own
# build/verify chain , both are npm LIFECYCLE scripts, and .npmrc's
# ignore-scripts suppresses every lifecycle script, first-party ones
# included, not just third-party dependency install scripts. Setting it
# repo-wide made `npm test` (pre-commit hook, CI) silently skip the build
# and run against a stale or missing dist. The install-time control lives
# instead on individual `npm ci` invocations (`npm ci --ignore-scripts` in
# .github/workflows/ci.yml), which suppresses only THIRD-PARTY dependency
# install scripts (preinstall/install/postinstall of packages under
# node_modules) at install time; `npm test` / `npm run build` are not
# `npm ci` and are unaffected.
#
# allow-git=none (npm >=11 config; docs:
# https://docs.npmjs.com/cli/v11/using-npm/config#allow-git): every
# dependency here is pinned to a registry version, so npm never resolves a
# dependency through a git reference. This closes that fetch path instead
# of leaving an unused one open.
allow-git=none
