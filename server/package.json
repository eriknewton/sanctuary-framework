{
  "name": "@sanctuary-framework/mcp-server",
  "version": "0.10.6",
  "description": "Your agent, your machine, your keys — an MCP server that adds encrypted state, approval gates, and a portable identity to any AI agent.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sanctuary-mcp-server": "dist/cli.js",
    "sanctuary": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run test/security",
    "test:integration": "vitest run test/integration",
    "test:conformance": "vitest run test/conformance",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "install-hooks": "node -e \"const fs=require('node:fs'),p=require('node:path'); const root=p.resolve(__dirname,'..'); const src=p.join(root,'.githooks','pre-commit'); const dst=p.join(root,'.git','hooks','pre-commit'); if(!fs.existsSync(src)){console.error('Error: .githooks/pre-commit not found at '+src);process.exit(1)} if(!fs.existsSync(p.join(root,'.git'))){console.error('Error: '+root+' is not a git repository');process.exit(1)} fs.mkdirSync(p.dirname(dst),{recursive:true}); fs.copyFileSync(src,dst); fs.chmodSync(dst,0o755); console.log('Installed pre-commit hook: '+dst)\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.5",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/crypto": "^5.1.17",
    "@libp2p/identify": "^3.0.39",
    "@libp2p/interface": "^2.11.0",
    "@libp2p/kad-dht": "^15.1.11",
    "@libp2p/mdns": "^11.0.47",
    "@libp2p/peer-id": "^5.1.9",
    "@libp2p/tcp": "^10.1.19",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@multiformats/multiaddr": "^12.5.1",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "hash-wasm": "^4.12.0",
    "it-length-prefixed": "^9.1.1",
    "it-pipe": "^3.0.1",
    "libp2p": "^2.10.0",
    "pg": "^8.20.0",
    "pgvector": "^0.2.1",
    "uint8arraylist": "^2.4.9",
    "uint8arrays": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eriknewton/sanctuary-framework.git",
    "directory": "server"
  },
  "keywords": [
    "sanctuary",
    "mcp",
    "sovereignty",
    "agent",
    "encryption",
    "identity",
    "reputation",
    "privacy"
  ],
  "author": "Erik Newton"
}
