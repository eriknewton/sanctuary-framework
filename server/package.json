{
  "name": "@sanctuary-framework/mcp-server",
  "version": "1.7.2",
  "mcpName": "ai.sanctuaryprotocol/sanctuary",
  "description": "The open source standard for secure, private AI: operating-system enforcement is live on macOS today; Linux and Windows are not live enforcement yet, and your data stays under your own keys with current portability bounds called out in the Assurance Matrix. Any agent, local or cloud, solo or fleet.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server": "dist/cli.js",
    "sanctuary-mcp-server": "dist/cli.js",
    "sanctuary": "dist/cli.js",
    "verify-transparency": "dist/verify-transparency.js",
    "verify-exit-bundle": "dist/cli.js",
    "import-exit-bundle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/sign-reference-plugin.mjs && tsup && npm run build:boot-runtime && node scripts/copy-templates.js",
    "build:boot-runtime": "tsup --config tsup.boot-runtime.config.ts",
    "sign-reference-plugin": "node scripts/sign-reference-plugin.mjs",
    "sign-release": "tsx scripts/sign-release-manifest.mjs",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:security": "vitest run test/security",
    "test:integration": "vitest run test/integration",
    "test:conformance": "vitest run test/conformance",
    "test:zero-pii-regression": "vitest run test/query-anonymity/zero-pii-regression.test.ts",
    "test:qla-perf-budget": "vitest run test/query-anonymity/performance-budget.test.ts",
    "synthetic-coverage": "tsx ../scripts/synthetic-coverage/run.ts",
    "synthetic-coverage:parity": "tsx ../scripts/synthetic-coverage/parity-cli.ts",
    "synthetic-coverage:baseline": "tsx ../scripts/synthetic-coverage/gen-coverage-baseline.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "npm run typecheck:src && npm run typecheck:tests",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "node scripts/check-typecheck-baseline.mjs",
    "typecheck:tests:raw": "tsc -p tsconfig.typecheck.json --pretty false",
    "typecheck:tests:update": "node scripts/check-typecheck-baseline.mjs --update",
    "lint": "eslint src/ --max-warnings 0",
    "refresh-reorg-evidence": "tsx scripts/refresh-reorg-evidence.ts",
    "check-import-cycles": "tsx scripts/check-import-cycles.ts",
    "check-import-cycles:baseline": "tsx scripts/check-import-cycles.ts > test/fixtures/import-cycle-baseline.txt",
    "gen-at-rest-fixtures": "tsx scripts/gen-at-rest-fixtures.ts",
    "hygiene": "npm run refresh-reorg-evidence && npm run check-import-cycles",
    "clean": "rm -rf dist",
    "install-hooks": "node scripts/install-hooks.js",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "14.1.2",
    "@chainsafe/libp2p-noise": "16.1.5",
    "@chainsafe/libp2p-yamux": "7.0.4",
    "@libp2p/crypto": "5.1.22",
    "@libp2p/identify": "3.0.39",
    "@libp2p/interface": "2.11.0",
    "@libp2p/kad-dht": "16.4.2",
    "@libp2p/mdns": "11.0.47",
    "@libp2p/peer-id": "5.1.9",
    "@libp2p/ping": "3.1.11",
    "@libp2p/tcp": "10.1.19",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@multiformats/multiaddr": "12.5.1",
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noble/post-quantum": "0.7.0",
    "hash-wasm": "4.12.0",
    "it-length-prefixed": "10.0.2",
    "it-pipe": "3.0.1",
    "libp2p": "2.10.0",
    "lmdb": "3.5.6",
    "pg": "8.23.0",
    "pgvector": "0.3.0",
    "uint8arraylist": "3.0.2",
    "uint8arrays": "6.1.1",
    "viem": "2.55.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriknewton/sanctuary-framework.git",
    "directory": "server"
  },
  "keywords": [
    "sanctuary",
    "mcp",
    "mcp-server",
    "sovereignty",
    "agent",
    "security",
    "egress-control",
    "audit",
    "encryption",
    "identity",
    "reputation",
    "privacy"
  ],
  "author": "Erik Newton",
  "overrides": {
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  }
}
