{
  "name": "@sanctuary-framework/mcp-server",
  "version": "1.4.0",
  "description": "Your agent, your machine, your keys. An MCP server that adds encrypted state, approval gates, and a portable identity to any AI agent.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sanctuary-mcp-server": "dist/cli.js",
    "sanctuary": "dist/cli.js",
    "verify-transparency": "dist/verify-transparency.js",
    "verify-exit-bundle": "dist/cli.js",
    "import-exit-bundle": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-templates.js",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:security": "vitest run test/security",
    "test:integration": "vitest run test/integration",
    "test:conformance": "vitest run test/conformance",
    "test:zero-pii-regression": "vitest run test/query-anonymity/zero-pii-regression.test.ts",
    "test:qla-perf-budget": "vitest run test/query-anonymity/performance-budget.test.ts",
    "synthetic-coverage": "tsx ../scripts/synthetic-coverage/run.ts",
    "synthetic-coverage:parity": "tsx ../scripts/synthetic-coverage/parity-cli.ts",
    "synthetic-coverage:baseline": "tsx ../scripts/synthetic-coverage/gen-coverage-baseline.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install chromium webkit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "refresh-reorg-evidence": "vite-node scripts/refresh-reorg-evidence.ts",
    "check-import-cycles": "vite-node scripts/check-import-cycles.ts",
    "check-import-cycles:baseline": "vite-node scripts/check-import-cycles.ts > test/fixtures/import-cycle-baseline.txt",
    "gen-at-rest-fixtures": "vite-node scripts/gen-at-rest-fixtures.ts",
    "hygiene": "npm run refresh-reorg-evidence && npm run check-import-cycles",
    "clean": "rm -rf dist",
    "install-hooks": "node scripts/install-hooks.js",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "14.1.2",
    "@chainsafe/libp2p-noise": "16.1.5",
    "@chainsafe/libp2p-yamux": "7.0.4",
    "@libp2p/crypto": "5.1.20",
    "@libp2p/identify": "3.0.39",
    "@libp2p/interface": "2.11.0",
    "@libp2p/kad-dht": "16.3.3",
    "@libp2p/mdns": "11.0.47",
    "@libp2p/peer-id": "5.1.9",
    "@libp2p/ping": "3.1.7",
    "@libp2p/tcp": "10.1.19",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@multiformats/multiaddr": "12.5.1",
    "@noble/ciphers": "2.2.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "hash-wasm": "4.12.0",
    "it-length-prefixed": "9.1.1",
    "it-pipe": "3.0.1",
    "libp2p": "2.10.0",
    "lmdb": "3.5.6",
    "pg": "8.22.0",
    "pgvector": "0.3.0",
    "uint8arraylist": "2.4.9",
    "uint8arrays": "5.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.0",
    "@types/node": "25.9.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.5.0",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eriknewton/sanctuary-framework.git",
    "directory": "server"
  },
  "keywords": [
    "sanctuary",
    "mcp",
    "sovereignty",
    "agent",
    "encryption",
    "identity",
    "reputation",
    "privacy"
  ],
  "author": "Erik Newton"
}
