{
  "mcpServers": {
    "your-agent-server": {
      "command": "your-agent-command",
      "args": ["--your-flags"],
      "env": {}
    },
    "sanctuary": {
      "command": "node",
      "args": ["./node_modules/.bin/sanctuary-mcp-server"],
      "env": {
        "SANCTUARY_FORTRESS_PATH": "/absolute/path/to/pre-provisioned-fortress",
        "SANCTUARY_DASHBOARD_ENABLED": "true"
      }
    }
  }
}
